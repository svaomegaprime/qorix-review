{% assign quote_loop_metafield = app.metafields.qorix_review.quote_loop.value %}
{% assign pp = app.metafields.qorix_review.pricing_plan.value.activePlan %}
{% if pp == 'standard-plan' or pp == 'pro-plan' or pp == 'plus-plan' or pp == 'unlimited' %}
  {{ 'swiper-bundle.min.css' | asset_url | stylesheet_tag }}
  {{ 'quoteloop.css' | asset_url | stylesheet_tag }}
  {% render 'custom-css', css: quote_loop_metafield.advanceCss %}
  <style>
    [data-section="qorix-quoteloop-widget"] {
      --active-dot-color: {{ quote_loop_metafield.activeDotColor | default: quote_loop_metafield.starColor | default: '#34C759' }};
    }
    [data-qorix-widget] { display: none !important; }
  </style>
  <div
    data-qorix-widget
    class="qr-quoteloop"
    data-section="qorix-quoteloop-widget"
    customerId="{{ customer.id }}"
    customerEmail="{{ customer.email }}"
    id="quick-review"
    x-data="ReviewWidget()"
    x-init="initUploadSettings($el); productInit($el.dataset.product,$el.dataset.sort,$el.dataset.limit)"
    data-customer-id="{{ customer.id }}"
    data-customer-email="{{ customer.email }}"
    data-sort="{{ quote_loop_metafield.defaultSort }}"
    data-limit="{{ quote_loop_metafield.reviewPerPage }}"
    data-page-type="{{ template.name }}"
    data-filter-min-stars="{{ quote_loop_metafield.fiteringMinStart }}"
  >
    {% if quote_loop_metafield.showHeader != blank %}
      {% render 'heading',
        label: quote_loop_metafield.eyebrowLabel,
        title: quote_loop_metafield.heading,
        subtitle: quote_loop_metafield.subheading,
        position: quote_loop_metafield.headerStyle,
        reviewStats: quote_loop_metafield.reviewStats,
        starColor: quote_loop_metafield.starColor,
        badgeColor: quote_loop_metafield.quoteMarkColor
      %}
    {% endif %}
    {% assign total_slides = 10 %}
    <div
      class="swiper qr-quote-swiper"
      data-desktop-slides="3"
      data-total-slides="{{ total_slides }}"
      data-quote-loop-autoplay="{{ quote_loop_metafield.autoSlider }}"
      data-quote-loop-speed="{{ quote_loop_metafield.speed }}"
    >
      <div class="swiper-wrapper">
        {% render 'quoteloop-review-card',
          cardBackgroundColor: quote_loop_metafield.cardBackgroundColor,
          quoteIconColor: quote_loop_metafield.quoteMarkColor,
          verifiedBadgeColor: quote_loop_metafield.verifiedBadgeColor,
          verifiedBageColor: quote_loop_metafield.quoteMarkColor,
          textColor: quote_loop_metafield.textColor,
          starColor: quote_loop_metafield.starColor,
          quoteFontSize: quote_loop_metafield.quoteFontSize,
          showQuoteMarkIcon: quote_loop_metafield.showQuoteMarkIcon,
          showReviewerName: quote_loop_metafield.showReviewerName,
          showStarDistribution: quote_loop_metafield.showStarDistribution,
          showVerifiedBadge: quote_loop_metafield.showVerifiedBadge,
          showProductName: quote_loop_metafield.showProductName,
          textLength: quote_loop_metafield.textLength,
          showMediaAsset: quote_loop_metafield.showMediaAsset,
          quote_loop_metafield: quote_loop_metafield
        %}
      </div>
      <div class="swiper-pagination"></div>
      {% if quote_loop_metafield.showArrowControls != false and quote_loop_metafield.showArrowControls != 'false' %}
        <div x-show="!loading" class="swiper-button-prev">
          {% render 'svg', name: 'arrow-prev-small' %}
        </div>
        <div x-show="!loading" class="swiper-button-next">
          {% render 'svg', name: 'arrow-next-small' %}
        </div>
      {% endif %}
    </div>
  </div>
  <script src="{{ 'swiper-bundle.min.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'quoteloop.js' | asset_url }}" defer="defer"></script>
{% endif %}
{% schema %}
{
  "name": "Quote Loop",
  "target": "section",
  "settings": []
}
{% endschema %}
