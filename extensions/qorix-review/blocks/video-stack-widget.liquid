{% assign video_stack_metafield = app.metafields.qorix_review.video_stack.value %}
{% assign pp = app.metafields.qorix_review.pricing_plan.value.activePlan %}
{% if pp == 'pro-plan' or pp == 'plus-plan' or pp == 'unlimited' %}
  {{ 'swiper-bundle.min.css' | asset_url | stylesheet_tag }}
  {{ 'video-stack-widget.css' | asset_url | stylesheet_tag }}
  {% render 'custom-css', css: video_stack_metafield.advanceCss %}
  <style>
    [data-section="qorix-review-video-stack-widget"] {
      position: relative !important;
      z-index: 1 !important;
      isolation: isolate !important;
      --nav-cols: {{ video_stack_metafield.thumbnailsShown | default: block.settings.nav_cols | default: 5 }};
      --star-color: {{ video_stack_metafield.startColor | default: '#F59E0B' }};
      --active-dot-color: {{ video_stack_metafield.activeDotColor | default: '#34C759' }};
      --badge-color: {{ video_stack_metafield.badgeColor | default: '#34C759' }};
      --overlay-tint: {{ video_stack_metafield.overlayTintColor | default: '#1A1A1A' }};
    }
    [data-qorix-widget] { display: none !important; }
  </style>
  <section
    data-qorix-widget
    class="qorix-review-video-stack-section"
    data-section="qorix-review-video-stack-widget"
    customerId="{{ customer.id }}"
    customerEmail="{{ customer.email }}"
    id="video-stack-widget"
    x-data="ReviewWidget()"
    x-init="initUploadSettings($el); productInit($el.dataset.product,$el.dataset.sort,$el.dataset.limit)"
    data-customer-id="{{ customer.id }}"
    data-customer-email="{{ customer.email }}"
    data-sort="ALL"
    data-limit="10000"
    data-page-type="{{ template.name }}"
    data-show-first="VIDEO"
    data-filter-min-stars="{{ video_stack_metafield.fiteringMinStart }}"
    data-isMuted="{{ video_stack_metafield.mutedByDefault }}"
    data-is-muted="{{ video_stack_metafield.mutedByDefault }}"
  >
    {% if video_stack_metafield.showHeader != false and video_stack_metafield.showHeader != 'false' %}
      <div class="qorix-review-video-stack-heading-container">
        {% render 'heading',
          label: video_stack_metafield.eyebrowLabel,
          title: video_stack_metafield.heading,
          subtitle: video_stack_metafield.subheading,
          position: video_stack_metafield.headerStyle,
          reviewStats: video_stack_metafield.reviewStats,
          starColor: video_stack_metafield.startColor,
          badgeColor: video_stack_metafield.badgeColor
        %}
      </div>
    {% endif %}
    <div class="qorix-review-video-stack-carousel">
      <div class="qorix-review-video-stack-swiper-clip">
        <div class="qorix-review-video-stack-swiper">
          <div class="qorix-review-video-stack-swiper-wrapper">
            {% render 'video-stack-widget-card', loop_video: true %}
          </div>
        </div>
      </div>
      {% if video_stack_metafield.showNavigationDots != false
        and video_stack_metafield.showNavigationDots != 'false'
        or video_stack_metafield.showArrowControls != false
        and video_stack_metafield.showArrowControls != 'false'
      %}
        <div class="qorix-review-video-stack-controls" x-show="filteredReviews().length > 0">
          {% if video_stack_metafield.showArrowControls != false
            and video_stack_metafield.showArrowControls != 'false'
          %}
            <button class="qorix-review-video-stack-nav qorix-review-video-stack-nav-prev" aria-label="Previous slide">
              {% render 'svg', name: 'chevron-left' %}
            </button>
          {% endif %}

          {% if video_stack_metafield.showNavigationDots != false
            and video_stack_metafield.showNavigationDots != 'false'
          %}
            <div class="qorix-review-video-stack-custom-pagination"></div>
          {% endif %}
          {% if video_stack_metafield.showArrowControls != false
            and video_stack_metafield.showArrowControls != 'false'
          %}
            <button class="qorix-review-video-stack-nav qorix-review-video-stack-nav-next" aria-label="Next slide">
              {% render 'svg', name: 'chevron-right' %}
            </button>
          {% endif %}
        </div>
      {% endif %}
    </div>
  </section>
  <script src="{{ 'swiper-bundle.min.js' | asset_url }}" defer></script>
  <script src="{{ 'video-stack-widget.js' | asset_url }}" defer></script>
{% endif %}
{% schema %}
{
  "name": "Qorix Video Stack",
  "target": "section",
  "settings": []
}
{% endschema %}
