<link rel="stylesheet" href="{{ 'quick-review.css' | asset_url }}">

<div x-data="quickReviewWidget()">
  <div class="wrap">
    {% comment %} Start:: Header section summary {% endcomment %}

    <div class="top-row">
      <div>
        <div class="cr-title">Customer Reviews</div>
        <div class="cr-score" id="avg-score">
          <b class="cr-score" x-text="avgScore()"></b> <span x-text="reviews.length + ' reviews'"></span>
        </div>
        <button class="write-btn" type="button" @click="openModal()">Write a review</button>
      </div>
      <div class="right-btns">
        <button
          class="icon-btn"
          type="button"
          title="Toggle filters"
          @click="filtersOpen = !filtersOpen"
        >
          <svg viewBox="0 0 24 24">
            <line x1="21" y1="10" x2="7" y2="10" />
            <line x1="21" y1="6" x2="3" y2="6" />
            <line x1="21" y1="14" x2="3" y2="14" />
            <line x1="21" y1="18" x2="7" y2="18" />
          </svg>
        </button>
        <div
          class="icon-btn"
          id="filter-btn"
          title="Filter"
          style="position: relative"
          @click="sortOpen = !sortOpen"
          @click.outside="sortOpen = false"
        >
          <svg viewBox="0 0 24 24">
            <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3" />
          </svg>
          <div
            class="sort-dropdown"
            id="sort-dd"
            :class="{ open: sortOpen }"
            @click.stop
          >
            <template x-for="option in sortOptions" :key="option">
              <div
                class="sort-option"
                :class="{ selected: activeSort === option }"
                @click="setSort(option)"
                x-text="option"
              ></div>
            </template>
          </div>
        </div>
      </div>
    </div>
    {% comment %} End:: Header section summary {% endcomment %}

    <div class="filter-section" id="filter-section" x-show="filtersOpen">
      <div class="filter-label">Filters</div>
      <div class="rating-label">Rating</div>
      <div class="filter-row" id="filter-row">
        <button
          class="filter-chip"
          type="button"
          :class="{ active: activeFilter === 'all' }"
          @click="activeFilter = 'all'"
        >
          All
        </button>
        <template x-for="rating in ratings" :key="rating">
          <button
            class="filter-chip"
            type="button"
            :class="{ active: activeFilter === rating }"
            @click="activeFilter = rating"
          >
            <span x-text="rating"></span>
            <span>
              <svg width="17" height="17" viewBox="0 0 17 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path
                  fill="#FF9500"
                  d="M9.51964 0.855C8.97604 -0.285 7.35604 -0.285 6.81244 0.855L5.14444 4.3494L1.30564 4.8546C0.0552353 5.0202 -0.446365 6.561 0.469235 7.4298L3.27724 10.0962L2.57284 13.9026C2.34244 15.1434 3.65404 16.0962 4.76284 15.495L8.16604 13.647L11.5692 15.495C12.678 16.0962 13.9896 15.1434 13.7592 13.9026L13.0548 10.0962L15.8628 7.4298C16.7772 6.561 16.2768 5.0202 15.0264 4.8546L11.1864 4.3494L9.51964 0.855Z"
                />
              </svg>
            </span>
          </button>
        </template>
      </div>
    </div>

    {% comment %} Start:: Review List show {% endcomment %}
    <div class="reviews-list" id="reviews-list">
      <template x-for="review in filteredReviews()" :key="review.id">
        <div class="review-item">
          <div class="stars-row">
            <template x-for="star in ratings" :key="'review-' + review.id + '-star-' + star">
              <svg width="20" height="20" viewBox="0 0 17 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path
                  :fill="star <= review.rating ? '#FF9500' : '#B5B5B5'"
                  d="M9.51964 0.855C8.97604 -0.285 7.35604 -0.285 6.81244 0.855L5.14444 4.3494L1.30564 4.8546C0.0552353 5.0202 -0.446365 6.561 0.469235 7.4298L3.27724 10.0962L2.57284 13.9026C2.34244 15.1434 3.65404 16.0962 4.76284 15.495L8.16604 13.647L11.5692 15.495C12.678 16.0962 13.9896 15.1434 13.7592 13.9026L13.0548 10.0962L15.8628 7.4298C16.7772 6.561 16.2768 5.0202 15.0264 4.8546L11.1864 4.3494L9.51964 0.855Z"
                />
              </svg>
            </template>
          </div>

          <div class="reviewer-row">
            <template x-if="review.avatar">
              <div>
                <img
                  class="avatar"
                  :src="review.avatar"
                  :alt="review.name"
                  @error="$event.target.style.display = 'none'; $event.target.nextElementSibling.style.display = 'flex'"
                  width="40"
                  height="40"
                >
                <div class="avatar-initials" style="display: none" x-text="initials(review.name)"></div>
              </div>
            </template>
            <template x-if="!review.avatar">
              <div class="avatar-initials" x-text="initials(review.name)"></div>
            </template>

            <div>
              <div class="reviewer-name-row">
                <span x-text="review.name"></span>
                <span x-show="review.verified">
                  <svg width="16" height="16" viewBox="0 0 18 18" fill="none">
                    <circle cx="9" cy="9" r="9" fill="#1a7d43" />
                    <path d="M5.21 9L7.74 11.53L12.79 6.47" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </span>
              </div>
              <div class="reviewer-time" x-text="review.time"></div>
            </div>
          </div>

          <div class="quick_review_product_name">
            <span x-text="review.product"></span>
            <div class="review-text" x-text="review.review"></div>
          </div>

          <div class="media-row" x-show="review.media.length > 0">
            <template x-for="media in review.media" :key="media.url + media.type">
              <div
                class="media-thumb-wrap"
                :title="media.type === 'image' ? 'Click to view' : 'Click to play'"
                @click="openLightbox(media)"
              >
                <img
                  :src="media.type === 'image' ? media.url : media.thumb"
                  :alt="media.type === 'image' ? 'review image' : 'video thumbnail'"
                  width="80"
                  height="80"
                >
                <div class="play-overlay" x-show="media.type === 'video'">
                  <svg viewBox="0 0 24 24">
                    <path d="M8 5v14l11-7z"></path>
                  </svg>
                </div>
              </div>
            </template>
          </div>
        </div>
      </template>

      <p
        x-show="filteredReviews().length === 0"
        style="color: #888; font-size: 14px; padding: 20px 0"
      >
        No reviews found.
      </p>
    </div>
    {% comment %} End:: Review List show {% endcomment %}
  </div>
  {% comment %} Start:: Popup video image {% endcomment %}
  <div class="lightbox" id="lightbox" :class="{ open: lightboxOpen }" @click="closeLightbox($event)">
    <button class="lightbox-close" type="button" @click="closeLightbox()">&#x2715;</button>
    <div class="lightbox-content" id="lightbox-content">
      <template x-if="lightboxMedia && lightboxMedia.type === 'image'">
        <img :src="lightboxMedia.url" alt="media" width="" height="">
      </template>
      <template x-if="lightboxMedia && lightboxMedia.type === 'video'">
        <video :src="lightboxMedia.url" controls autoplay></video>
      </template>
    </div>
  </div>
  {% comment %} End:: Popup video image {% endcomment %}

  {% comment %} Start:: Review form and success {% endcomment %}

  <div class="modal-overlay" id="modal-overlay" :class="{ open: modalOpen }" @click="overlayClick($event)">
    <div class="modal-box" id="modal-box" x-ref="modalBox">
      <button class="modal-close" type="button" @click="closeModal()">&#x2715;</button>
      {% comment %} Start:: form  {% endcomment %}
      <form id="form-view" @submit.prevent="submitReview" x-show="!submitSuccess">
        <div class="modal-header">
          <div class="modal-icon">
            <svg viewBox="0 0 24 24" fill="#fff">
              <path
                d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04a1 1 0 000-1.41l-2.34-2.34a1 1 0 00-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"
              />
            </svg>
          </div>
          <div>
            <div class="modal-title">How was your experience?</div>
            <div class="modal-sub">Your feedback helps others</div>
          </div>
        </div>

        <label class="form-label">Your rating <span class="req">*</span></label>
        <div class="star-picker" id="star-picker">
          <template x-for="star in ratings" :key="'picker-' + star">
            <span
              role="button"
              tabindex="0"
              @mouseenter="starHover = star"
              @mouseleave="starHover = 0"
              @click="starSelected = star"
              @keydown.enter.prevent="starSelected = star"
              @keydown.space.prevent="starSelected = star"
              :aria-label="'Rate ' + star + ' stars'"
            >
              <svg width="32" height="32" viewBox="0 0 17 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path
                  :fill="star <= (starHover || starSelected) ? '#FF9500' : '#B5B5B5'"
                  d="M9.51964 0.855C8.97604 -0.285 7.35604 -0.285 6.81244 0.855L5.14444 4.3494L1.30564 4.8546C0.0552353 5.0202 -0.446365 6.561 0.469235 7.4298L3.27724 10.0962L2.57284 13.9026C2.34244 15.1434 3.65404 16.0962 4.76284 15.495L8.16604 13.647L11.5692 15.495C12.678 16.0962 13.9896 15.1434 13.7592 13.9026L13.0548 10.0962L15.8628 7.4298C16.7772 6.561 16.2768 5.0202 15.0264 4.8546L11.1864 4.3494L9.51964 0.855Z"
                />
              </svg>
            </span>
          </template>
        </div>

        <label class="form-label">Your name <span class="req">*</span></label>
        <input
          class="form-input"
          id="review-name"
          type="text"
          placeholder="Enter your name"
          x-model="form.name"
        >

        <label class="form-label">Email <span class="req">*</span></label>
        <input
          class="form-input"
          id="review-email"
          type="email"
          required
          placeholder="Enter your email"
          x-model="form.email"
        >

        <label class="form-label">Your review <span class="req">*</span></label>
        <textarea
          class="form-textarea"
          id="review-text"
          placeholder="Tell us what you loved or didn't like..."
          x-model="form.review"
        ></textarea>
        <label class="form-label">Add media <span style="font-weight: 400; color: #888">(optional)</span></label>
        <input
          type="file"
          id="media-input"
          accept="image/jpeg,image/png,image/webp,video/mp4,video/quicktime"
          multiple
          style="display: none"
          x-ref="mediaInput"
          @change="handleMediaUpload($event)"
        >
        <div
          class="upload-zone"
          id="upload-zone"
          :class="{ 'drag-over': isDragging }"
          @click="$refs.mediaInput.click()"
          @dragover.prevent="isDragging = true"
          @dragleave="isDragging = false"
          @drop.prevent="handleDrop($event)"
        >
          <svg viewBox="0 0 24 24">
            <path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4" />
            <polyline points="17 8 12 3 7 8" />
            <line x1="12" y1="3" x2="12" y2="15" />
          </svg>
          <p>Click to upload or drag and drop</p>
          <small>JPG, PNG, MP4, MOV up to 20MB each</small>
        </div>
        <div
          id="media-preview"
          style="display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 14px"
          x-show="uploadedFiles.length > 0"
        >
          <template x-for="(file, index) in uploadedFiles" :key="file.url">
            <div class="preview-item">
              <template x-if="file.isVideo">
                <video :src="file.url" muted playsinline></video>
              </template>
              <template x-if="!file.isVideo">
                <img :src="file.url" alt="preview" width="" height="">
              </template>
              <div class="preview-video-badge" x-show="file.isVideo">VIDEO</div>
              <button class="preview-remove" type="button" @click="removeMedia(index)">&#x2715;</button>
            </div>
          </template>
        </div>

        <button class="submit-btn" type="submit" >Submit review</button>
        <div class="modal-footer-note">
          <svg viewBox="0 0 24 24">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
            <path d="M7 11V7a5 5 0 0110 0v4" />
          </svg>
          No account required &middot; Your review is public
        </div>
      </form>
      {% comment %} End:: form  {% endcomment %}
      {% comment %} Start:: success message  {% endcomment %}

      <div
        id="success-view"
        :style="
          {
            display: submitSuccess ? 'flex' : 'none',
            flexDirection: 'column',
            alignItems: 'center',
            justifyContent: 'center',
            minHeight: '320px'
          }
        "
      >
        <div class="success-box">
          <div class="success-circle">
            <svg viewBox="0 0 24 24">
              <path d="M5 13l4 4L19 7" />
            </svg>
          </div>
          <div class="success-title">Review submitted!</div>
          <div class="success-sub">Thank you for your review. It has been submitted successfully.</div>
          <button class="continue-btn" type="button" @click="closeModal()">Continue Shopping</button>
        </div>
      </div>
      {% comment %} End:: success message  {% endcomment %}
    </div>
  </div>
  {% comment %} End:: Review form and success {% endcomment %}
</div>

<script src="{{ 'quick-review.js'| asset_url }}" defer></script>

<script src="{{ 'alpine.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Quick review widget",
  "target": "section",
  "settings": []
}
{% endschema %}
