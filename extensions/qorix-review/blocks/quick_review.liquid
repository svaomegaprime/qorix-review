{% assign quick_review_metafield = app.metafields.qorix_review.quick_review.value %}
{% liquid
  assign allow_photo = quick_review_metafield.isPhotoUpload
  assign allow_video = quick_review_metafield.isVideoUpload
  assign media_accept = ''
  if allow_photo
    assign media_accept = 'image/jpeg,image/png,image/webp'
  endif
  if allow_photo and allow_video
    assign media_accept = media_accept | append: ','
  endif
  if allow_video
    assign media_accept = media_accept | append: 'video/mp4,video/quicktime'
  endif
%}

<style>
  :root{
    --star-color: {{ quick_review_metafield.starColor }};
    --button-background-color: {{ quick_review_metafield.buttonBackgroundColor }};
    --button-text-color : {{ quick_review_metafield.buttonTextColor }};
    --verified-badge-color : {{ quick_review_metafield.verifiedBadgeColor }};

  }
</style>

<link rel="stylesheet" href="{{ 'quick-review.css' | asset_url }}">

<div
  {% comment %} xx="{{ product.metafields.reviews.rating }} - {{ product.metafields.reviews.rating_count.value }}" {% endcomment %}
  id="quick-review"
  {% comment %} x-data="quickReviewWidget()" {% endcomment %}
  x-data="ReviewWidget()"
  x-init="initUploadSettings($el); productInit($el.dataset.product,$el.dataset.sort,$el.dataset.limit)"
  data-product="{{ product | json | escape }}"
  data-photo-upload="{{ allow_photo | json }}"
  data-video-upload="{{ allow_video | json }}"
  data-sort="{{ quick_review_metafield.defaultSort }}"
  data-limit="{{ quick_review_metafield.reviewPerPage }}"
  data-page-type="{{ template.name }}"
>
  <div class="wrap">
    {% comment %} Start:: Header section summary {% endcomment %}

    <div class="top-row">
      <div>
        <div class="cr-title">Customer Reviews</div>
        <div class="cr-score" id="avg-score">
          <b class="cr-score" x-text="averageRating"></b> <span x-text="totalReviews + ' reviews'"></span>
        </div>
        <button class="write-btn" type="button" @click="openModal()">Write a review</button>
      </div>
      <div class="right-btns">
        <button
          class="icon-btn"
          type="button"
          title="Toggle filters"
          @click="filtersOpen = !filtersOpen"
        >
          <svg viewBox="0 0 24 24">
            <line x1="21" y1="10" x2="7" y2="10" />
            <line x1="21" y1="6" x2="3" y2="6" />
            <line x1="21" y1="14" x2="3" y2="14" />
            <line x1="21" y1="18" x2="7" y2="18" />
          </svg>
        </button>
        <div
          class="icon-btn"
          id="filter-btn"
          title="Filter"
          style="position: relative"
          @click="sortOpen = !sortOpen"
          @click.outside="sortOpen = false"
        >
          <svg viewBox="0 0 24 24">
            <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3" />
          </svg>
          <div
            class="sort-dropdown"
            id="sort-dd"
            :class="{ open: sortOpen }"
            @click.stop
          >
            <template x-for="option in sortOptions" :key="option.value">
              <div
                class="sort-option"
                :class="{ selected: '{{quick_review_metafield.defaultSort}}' === option.value }"
                @click="setSort(option.value)"
                x-text="option.label"
              ></div>
            </template>
          </div>
        </div>
      </div>
    </div>
    {% comment %} End:: Header section summary {% endcomment %}

    <div class="filter-section" id="filter-section" x-show="filtersOpen">
      <div class="filter-label">Filters</div>
      <div class="rating-label">Rating</div>
      <div class="filter-row" id="filter-row">
        <button
          class="filter-chip"
          type="button"
          :class="{ active: activeFilter === 'ALL' }"
          @click="setRatingFilter('ALL')"
        >
          All
        </button>
        <template x-for="rating in ratings" :key="rating">
          <button
            class="filter-chip"
            type="button"
            :class="{ active: Number(activeFilter) === rating }"
            @click="setRatingFilter(rating)"
          >
            <span x-text="rating"></span>
            <span>
              <svg width="17" height="17" viewBox="0 0 17 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path
                  fill="{{ quick_review_metafield.starColor }}"
                  d="M9.51964 0.855C8.97604 -0.285 7.35604 -0.285 6.81244 0.855L5.14444 4.3494L1.30564 4.8546C0.0552353 5.0202 -0.446365 6.561 0.469235 7.4298L3.27724 10.0962L2.57284 13.9026C2.34244 15.1434 3.65404 16.0962 4.76284 15.495L8.16604 13.647L11.5692 15.495C12.678 16.0962 13.9896 15.1434 13.7592 13.9026L13.0548 10.0962L15.8628 7.4298C16.7772 6.561 16.2768 5.0202 15.0264 4.8546L11.1864 4.3494L9.51964 0.855Z"
                />
              </svg>
            </span>
          </button>
        </template>
      </div>
    </div>

    {% comment %} Start:: Review List show {% endcomment %}
    <h3 x-show="loading">Loading review data...</h3>
    <div class="reviews-list" id="reviews-list" x-show="loading == false">
      <template x-for="review in filteredReviews()" :key="review.id">
        <div class="review-item">
          {% if quick_review_metafield.isShowRatingFilter %}
            <div class="stars-row">
              <template x-for="star in ratings" :key="'review-' + review.id + '-star-' + star">
                <svg width="20" height="20" viewBox="0 0 17 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path
                    :fill="star <= review.rating ? '{{ quick_review_metafield.starColor }}' : '#B5B5B5'"
                    d="M9.51964 0.855C8.97604 -0.285 7.35604 -0.285 6.81244 0.855L5.14444 4.3494L1.30564 4.8546C0.0552353 5.0202 -0.446365 6.561 0.469235 7.4298L3.27724 10.0962L2.57284 13.9026C2.34244 15.1434 3.65404 16.0962 4.76284 15.495L8.16604 13.647L11.5692 15.495C12.678 16.0962 13.9896 15.1434 13.7592 13.9026L13.0548 10.0962L15.8628 7.4298C16.7772 6.561 16.2768 5.0202 15.0264 4.8546L11.1864 4.3494L9.51964 0.855Z"
                  />
                </svg>
              </template>
            </div>
          {% endif %}

          <div class="reviewer-row">
            <template x-if="review.avatar">
              <div>
                <img
                  class="avatar"
                  :src="review.avatar"
                  :alt="review.reviewerName"
                  @error="$event.target.style.display = 'none'; $event.target.nextElementSibling.style.display = 'flex'"
                  width="40"
                  height="40"
                >
                <div class="avatar-initials" style="display: none" x-text="initials(review.reviewerName)"></div>
              </div>
            </template>
            <template x-if="!review.avatar">
              <div class="avatar-initials" x-text="initials(review.reviewerName)"></div>
            </template>

            <div>
              <div class="reviewer-name-row">
                {%- if quick_review_metafield.isShowReviewerName -%}
                  <span x-text="review.reviewerName"></span>
                {%- endif -%}
                {%- if quick_review_metafield.isShowVerifiedBadge -%}
                  <span x-show="review.isVerified">
                    <svg width="16" height="16" viewBox="0 0 18 18" fill="none">
                      <circle cx="9" cy="9" r="9" fill="{{ quick_review_metafield.verifiedBadgeColor }}" />
                      <path d="M5.21 9L7.74 11.53L12.79 6.47" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  </span>
                {% endif %}
              </div>
              {%- if quick_review_metafield.isShowReviewDate -%}
                <div class="reviewer-time" x-text="timeAgo(review.createdAt)"></div>
              {%- endif -%}
            </div>
          </div>

          <div class="quick_review_product_name">
            {%- if quick_review_metafield.isShowProductName -%}<span x-text="review.productTitle"></span>{%- endif -%}
            <div class="review-text" x-text="review.body"></div>
          </div>

          <div class="media-row" x-show="review.attachments.length > 0">
            <template x-for="media in review.attachments" :key="media.url + media.type">
              <template
                x-if="
                  (media.type === 'IMAGE' && {{ quick_review_metafield.isShowReviewerImage | json }}) ||
                  (media.type === 'VIDEO' && {{ quick_review_metafield.isShowReviewerVideo | json }})
                "
              >
                <div
                  class="media-thumb-wrap"
                  :title="media.type === 'IMAGE' ? 'Click to view' : 'Click to play'"
                  @click="openLightbox(media)"
                >
                  <img
                    :src="encodeURI(media.url)"
                    :alt="media.type === 'IMAGE' && 'review image'"
                    x-show="media.type === 'IMAGE'"
                    width="80"
                    height="80"
                  >
                  <video
                    x-show="media.type === 'VIDEO'"
                    :src="encodeURI(media.url)"
                    width="80"
                    height="80"
                    muted
                    preload="metadata"
                  ></video>

                  <div class="play-overlay" x-show="media.type === 'VIDEO'">
                    <svg viewBox="0 0 24 24">
                      <path d="M8 5v14l11-7z"></path>
                    </svg>
                  </div>
                </div>
              </template>
            </template>
          </div>
        </div>
      </template>

      <p
        x-show="filteredReviews().length === 0"
        style="color: #888; font-size: 14px; padding: 20px 0"
      >
        No reviews found.
      </p>
    </div>
    {% comment %} End:: Review List show {% endcomment %}
  </div>
  {% comment %} Start:: Popup video image {% endcomment %}
  <div class="lightbox" id="lightbox" :class="{ open: lightboxOpen }" @click="closeLightbox($event)">
    <button class="lightbox-close" type="button" @click="closeLightbox()">&#x2715;</button>
    <div class="lightbox-content" id="lightbox-content">
      <template x-if="lightboxMedia && lightboxMedia.type === 'IMAGE'">
        <img :src="lightboxMedia.url" alt="media" width="" height="">
      </template>
      <template x-if="lightboxMedia && lightboxMedia.type === 'VIDEO'">
        <video :src="lightboxMedia.url" controls autoplay></video>
      </template>
    </div>
  </div>
  {% comment %} End:: Popup video image {% endcomment %}

  {% comment %} Start:: Review form and success {% endcomment %}
  {% comment %}
  {% endcomment %}
  {% render 'form',
    quick_review_metafield: quick_review_metafield,
    allow_photo: allow_photo,
    allow_video: allow_video,
    media_accept: media_accept
  %}

  {% comment %} End:: Review form and success {% endcomment %}
  <div class="pagination">
    <div @click="prevPage()">&#10094;</div>

    <div
      x-show="currentPage > 1"
      x-text="currentPage - 1"
      @click="changePage(currentPage - 1)"
    ></div>

    <div
      class="active"
      x-text="currentPage"
    ></div>

    <div
      x-show="currentPage < totalPages"
      x-text="currentPage + 1"
      @click="changePage(currentPage + 1)"
    ></div>

    <div @click="nextPage()">&#10095;</div>
  </div>
</div>

<script src="{{ 'review.js'| asset_url }}" defer></script>

<script src="{{ 'alpine.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Quick review widget",
  "target": "section",
  "settings": [],
  "enabled_on": {
    "templates": ["product"]
  }
}
{% endschema %}
