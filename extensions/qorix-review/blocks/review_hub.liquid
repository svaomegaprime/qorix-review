{% assign quick_review_metafield = app.metafields.qorix_review.quick_review.value %}
{% liquid
  assign allow_photo = quick_review_metafield.isPhotoUpload
  assign allow_video = quick_review_metafield.isVideoUpload
  assign media_accept = ''
  if allow_photo
    assign media_accept = 'image/jpeg,image/png,image/webp'
  endif
  if allow_photo and allow_video
    assign media_accept = media_accept | append: ','
  endif
  if allow_video
    assign media_accept = media_accept | append: 'video/mp4,video/quicktime'
  endif
%}

{{ 'review-hub.css' | asset_url | stylesheet_tag }}
<script src="{{ 'review-hub.js' | asset_url }}" defer></script>

<div
  class="qr-review-hub"
  {% comment %} xx="{{ product.metafields.reviews.rating }} - {{ product.metafields.reviews.rating_count.value }}" {% endcomment %}
  id="quick-review"
  {% comment %} x-data="quickReviewWidget()" {% endcomment %}
  x-data="ReviewWidget()"
  x-init="initUploadSettings($el); productInit($el.dataset.product,$el.dataset.sort,$el.dataset.limit)"
  data-product="{{ product | json | escape }}"

  data-photo-upload="{{ allow_photo | json }}"
  data-video-upload="{{ allow_video | json }}"
  data-sort="{{ quick_review_metafield.defaultSort }}"
  data-limit="{{ quick_review_metafield.reviewPerPage }}"
  data-page-type="{{ template.name }}"
>
  {% render 'heading',
    label: block.settings.label,
    title: block.settings.title,
    subtitle: block.settings.subtitle,
    rating: block.settings.rating,
    review_count: block.settings.review_count
  %}

  <div class="qr-reviews-section">
    {% render 'review-filters' %}

    <div class="qr-review-grid">
      {%- for i in (1..6) -%}
        {%- assign img_count = 1 -%}
        {%- if i == 2 -%}{%- assign img_count = 4 -%}{%- endif -%}
        {%- if i == 5 -%}{%- assign img_count = 4 -%}{%- endif -%}
        {% render 'review-card',
          reviewer_name: 'Hasan R.',
          review_date: '2 days ago',
          rating: 5,
          review_text: 'Absolutely love the serum! My skin feels so smooth and hydrated.',
          product_tag: 'Hydrating serum',
          helpful_count: 24,
          image_count: img_count
        %}
      {%- endfor -%}
    </div>

    {% comment %} Start:: Review form and success {% endcomment %}
    {% render 'form', quick_review_metafield: 10, allow_photo: true, allow_video: true, media_accept: true %}
    {% comment %} End:: Review form and success {% endcomment %}

    <div class="qr-load-more-wrap">
      <button class="qr-load-more-btn" type="button">Load more reviews</button>
    </div>
  </div>
</div>

<script src="{{ 'review.js'| asset_url }}" defer></script>

<script src="{{ 'alpine.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Review Hub",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Small label text",
      "default": "Customer Reviews"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading title",
      "default": "What customers love about us"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Watch and hear what our customers have to say."
    },
    {
      "type": "range",
      "id": "rating",
      "label": "Rating",
      "min": 0,
      "max": 5,
      "step": 0.1,
      "default": 4.9
    },
    {
      "type": "number",
      "id": "review_count",
      "label": "Review count",
      "default": 2451
    }
  ]
}
{% endschema %}
