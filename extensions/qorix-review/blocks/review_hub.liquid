{{ 'review-hub.css' | asset_url | stylesheet_tag }}
{% assign review_hub_metafield = app.metafields.qorix_review.review_hub.value %}

{% comment %} <script src="{{ 'review-hub.js' | asset_url }}" defer></script> {% endcomment %}

<div
  class="qr-review-hub"
  style="--qr-grid-columns: {{ block.settings.columns_desktop }}; --qr-section-max-width: {{ block.settings.section_width }}px;"
  customerId="{{ customer.id }}"
  customerEmail="{{ customer.email }}"
  {% comment %} xx="{{ product.metafields.reviews.rating }} - {{ product.metafields.reviews.rating_count.value }}" {% endcomment %}
  id="quick-review"
  {% comment %} x-data="quickReviewWidget()" {% endcomment %}
  x-data="ReviewWidget()"
  x-init="initUploadSettings($el); productInit($el.dataset.product,$el.dataset.sort,$el.dataset.limit)"
  data-customer-id="{{ customer.id }}"
  data-customer-email="{{ customer.email }}"
  data-product="{{ product | json | escape }}"
  {% comment %}
    data-photo-upload="{{ allow_photo | json }}"
    data-video-upload="{{ allow_video | json }}"
  {% endcomment %}
  data-sort="{{ review_hub_metafield.filterSorting }}"
  data-limit="{{ review_hub_metafield.reviewsPerPage }}"
  data-page-type="{{ template.name }}"
>
  {% if review_hub_metafield.showHeader %}
    {% render 'heading',
      label: review_hub_metafield.eyebrowLabel,
      title: review_hub_metafield.heading,
      subtitle: review_hub_metafield.subheading,
      position: review_hub_metafield.headerStyle,
      review_hub_metafield: review_hub_metafield
    %}
  {% endif %}

  <div class="qr-reviews-section" ddd="{{review_hub_metafield}}">
    {% render 'review-filters', review_hub_metafield: review_hub_metafield %}

    <div class="qr-review-grid">
      {% comment %}
        {%- for i in (1..6) -%}
        {%- assign img_count = 1 -%}
        {%- if i == 2 -%}{%- assign img_count = 4 -%}{%- endif -%}
        {%- if i == 5 -%}{%- assign img_count = 4 -%}{%- endif -%}

        {%- assign media_1_type = 'image' -%}
        {%- assign media_1_url = 'card_img.png' | asset_url -%}
        {%- assign media_2_type = 'image' -%}
        {%- assign media_2_url = 'card_img.png' | asset_url -%}
      {% endcomment %}

      {% render 'review-card' %}
    </div>

    <div class="qr-load-more-wrap" x-show="hasMoreReviews()">
      <button class="qr-load-more-btn" type="button" @click="loadMore()">Load more reviews</button>
    </div>
  </div>
  {% render 'lightbox' %}
</div>

<script src="{{ 'review.js' | asset_url }}" defer></script>
<script src="{{ 'alpine.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Review Hub",
  "target": "section",
  "settings": [
    {
      "type": "range",
      "id": "section_width",
      "label": "Section max width (px)",
      "min": 800,
      "max": 2520,
      "step": 20,
      "default": 1100
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Cards per row (desktop)",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 3
    },

    {
      "type": "text",
      "id": "label",
      "label": "Small label text",
      "default": "Customer Reviews"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading title",
      "default": "What customers love about us"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Watch and hear what our customers have to say."
    },
    {
      "type": "range",
      "id": "rating",
      "label": "Rating",
      "min": 0,
      "max": 5,
      "step": 0.1,
      "default": 4.9
    },
    {
      "type": "number",
      "id": "review_count",
      "label": "Review count",
      "default": 2451
    }
  ]
}
{% endschema %}
