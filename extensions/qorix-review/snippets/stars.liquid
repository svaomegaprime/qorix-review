{%- assign full_stars = rating | round -%}

<div class="qr-stars">
  {%- for i in (1..5) -%}
    <span class="qr-star-icon">
      {%- if i <= full_stars -%}
        {% render 'icon', name: 'star', color: '#34C759' %}
      {%- else -%}
        {% render 'icon', name: 'star', color: '#E0E0E0' %}
      {%- endif -%}
    </span>
  {%- endfor -%}
</div>