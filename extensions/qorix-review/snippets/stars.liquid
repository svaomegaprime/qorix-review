<div class="qr-stars">
  <template x-for="star in 5" :key="star">
    <span class="qr-star-icon">
      <template
        x-if="
          star <= Math.floor(
            {% if from == 'heading' %}averageRating{% endif %}
            {% if from == 'reviewHubCardStar' %}review.rating{% endif %}
            {% if from == 'quoteloopReview' %}review.rating{% endif %}
            {% if from == 'videoStack' %}review.rating{% endif %}
            {% if from == 'rating_summary' %}averageRating{% endif %}

          )
        "
      >
        {% render 'icon', name: 'star', color: starColor %}
      </template>
      <template
        x-if="
          star > Math.floor(
            {% if from == 'heading' %}averageRating{% endif %}
            {% if from == 'reviewHubCardStar' %}review.rating{% endif %}
            {% if from == 'quoteloopReview' %}review.rating{% endif %}
            {% if from == 'videoStack' %}review.rating{% endif %}
            {% if from == 'rating_summary' %}averageRating{% endif %}

          )
        "
      >
        {% render 'icon', name: 'star', color: '#E0E0E0' %}
      </template>
    </span>
  </template>
</div>
