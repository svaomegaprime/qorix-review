{{ 'quickreview-media-slider.css' | asset_url | stylesheet_tag }}
<div x-show="attachments.length > 0 ? true : showMediaWithoutRating" class="qorix-qr-media-container">
  <div class="qorix-qr-media-header">
    <span class="qorix-qr-media-title">Reviews with media</span>
    <p class="qorix-qr-media-see-all" @click="openMediaModal()">See all media</p>
  </div>
  <div class="qorix-qr-media-slider-wrap">
    <div class="qorix-qr-media-nav-prev" data-quickreview-nav-prev x-show="attachments?.length">
      {% render 'svg', name: 'arrow-prev-small' %}
    </div>
    <div class="qorix-qr-media-slider swiper" data-quickreview-swiper>
      <div class="swiper-wrapper">
        <template x-if="attachments?.length">
          <template x-for="attachment in attachments" :key="attachment.id">
            <div class="swiper-slide qorix-qr-media-slide" @click="openLightbox(attachment)">
              <template x-if="attachment.type === 'IMAGE' && !loading">
                <img
                  class="qorix-qr-media-img"
                  :src="attachment.url"
                  alt="Review media"
                  width=""
                  height=""
                >
              </template>
              <template x-if="attachment.type === 'VIDEO' && !loading">
                <div style="position: relative; width: 100%; height: 100%;">
                  <video
                    class="qorix-qr-media-img"
                    :src="attachment.url + '#t=0.001'"
                    preload="metadata"
                    muted
                    playsinline
                  ></video>
                  <div
                    class="qorix-video-play-badge"
                    style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 32px; height: 32px; border-radius: 50%; background: rgba(255, 255, 255, 0.92); display: flex; align-items: center; justify-content: center; pointer-events: none; z-index: 2; box-shadow: 0 2px 8px rgba(0, 0, 0, 0.25);"
                  >
                    {% render 'svg', name: 'play-badge' %}
                  </div>
                </div>
              </template>
            </div>
          </template>
        </template>
        <div x-show="attachments?.length < 1 && !loading">
          <div style="height: 128px;min-width: 126px; display:flex; gap: 10px;">
            {% for i in (1..10) %}
              <img
                style="min-width:126px; border: 1px solid #00000009;"
                src="{{'placeholder-images-image_large.png' | asset_url}}"
                width="100px"
                height="128px"
              >
            {% endfor %}
          </div>
        </div>
        {% render 'skeleton', type: 'media' %}
      </div>
    </div>
    <div class="qorix-qr-media-nav-next" data-quickreview-nav-next x-show="attachments?.length">
      {% render 'svg', name: 'arrow-next-small' %}
    </div>
  </div>
</div>
{% render 'show-all-media-modal' %}
