{% assign review_reel_metafield = app.metafields.qorix_review.review_reel.value %}

{% assign show_reviewer_name = showReviewerName %}
{% if show_reviewer_name == null %}
  {% assign show_reviewer_name = review_reel_metafield.showReviewerName %}
{% endif %}

{% assign show_review_image = showReviewImage %}
{% if show_review_image == null %}
  {% assign show_review_image = review_reel_metafield.showReviewImage %}
{% endif %}

{% assign show_verified_badge = showVerifiedBadge %}
{% if show_verified_badge == null %}
  {% assign show_verified_badge = review_reel_metafield.showVerifiedBadge %}
{% endif %}

{% assign show_product_name = showProductName %}
{% if show_product_name == null %}
  {% assign show_product_name = review_reel_metafield.showProductName %}
{% endif %}

{% assign show_review_date = showReviewDate %}
{% if show_review_date == null %}
  {% assign show_review_date = review_reel_metafield.showReviewDate %}
{% endif %}

{% assign start_color_val = startColor | default: review_reel_metafield.startColor | default: '#34C759' %}
{% render 'skeleton', type: 'card' %}
<template x-for="review in filteredReviews()" :key="review.id">
  <div class="qorix-review-reel-swiper-slide swiper-slide" x-show="!loading">
    <div class="qorix-review-reel-review-card">
      <div
        x-show="review.attachments[0] && review.attachments[0].type == 'VIDEO'"
        class="qorix-review-reel-review-card-image"
        data-media-type="video"
        :data-video-src="review.attachments[0].url"
      >
        <video
          :src="review.attachments[0].url"
          playsinline
          loop
          preload="metadata"
          class="qorix-review-reel-card-video"
        ></video>
        <button class="qorix-review-reel-play-btn" aria-label="Play video review">
          <svg width="44" height="44" viewBox="0 0 44 44" fill="none" xmlns="http://www.w3.org/2000/svg">
            <circle cx="22" cy="22" r="22" fill="white" />
            <path d="M27.5 22L19.25 27.1962V16.8038L27.5 22Z" fill="#303030"/>
          </svg>
        </button>
      </div>

      <div
        x-show="review.attachments[0] && review.attachments[0].type == 'IMAGE'"
        class="qorix-review-reel-review-card-image"
        data-media-type="image"
      >
        <img
          :src="review?.attachments[0]?.url"
          alt=""
          width=""
          height=""
        >
      </div>

      <div class="qorix-review-reel-review-card-content">
        <div class="qorix-review-reel-review-text">
          {% if show_product_name %}
            <p class="qorix-review-reel-product-title">Product: <span x-text="review.productTitle"></span></p>
          {% endif %}

          <h3 x-show="review.body" class="qorix-review-reel-review-quote qorix-review-reel-line-clamp">
            "<span x-text="review.body"></span>"
          </h3>
        </div>
        <div class="qorix-review-reel-review-user">
          {% if show_review_image %}
            <img
              class="qorix-review-reel-user-avatar"
              :src="review.reviewerImage"
              x-show="review.reviewerImage"
              alt=""
              width=""
              height=""
            >
            <span
              class="qr-review-avatar"
              x-show="!review.reviewerImage"
              x-text="review.reviewerName ? review.reviewerName[0].toUpperCase() : ''"
              style="font-size: 18px;"
            ></span>
          {% endif %}
          <div class="qorix-review-reel-user-info">
            {% if show_reviewer_name %}
              <p class="qorix-review-reel-user-name">
                <span x-text="review.reviewerName"></span>
                {% if show_verified_badge != false and show_verified_badge != 'false' and verified != false %}
                  <svg
                    width="18"
                    height="18"
                    viewBox="0 0 18 18"
                    fill="none"
                    style="vertical-align: middle; margin-left: 4px; display: inline-block;"
                    aria-label="Verified"
                  >
                    <circle cx="9" cy="9" r="9" fill="{{ start_color_val }}" />
                    <path d="M5 9L7.5 11.5L13 6" stroke="white" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                {% endif %}
              </p>
            {% endif %}
            {% if show_review_date %}
              <p class="qorix-review-reel-review-date" x-text="timeAgo(review.createdAt)"></p>
            {% endif %}
          </div>
        </div>
      </div>
    </div>
  </div>
</template>
<p
  x-show="filteredReviews().length === 0 && !loading"
  style="color: #888; font-size: 14px; padding: 20px 0"
>
  No reviews found.
</p>
