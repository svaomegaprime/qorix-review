{{ 'quickreview-reviews.css' | asset_url | stylesheet_tag }}
<div
  class="quickreview-reviews"
  data-product-id="{{ product.id }}"
  id="quickreview-reviews-{{ block.id }}"
  x-show="filteredReviews().length > 0 ? true : showReviewBodyWithoutRating"
>
  <div class="quickreview-reviews__header">
    <div class="quickreview-reviews__titles">
      <h2 class="quickreview-reviews__title">Product Reviews</h2>
      <p class="quickreview-reviews__subtitle">of {{ product.title }}</p>
    </div>

    <div class="quickreview-reviews__actions">
      {% if quick_review_metafield.filterAndSorting == 'FILTER_AND_SORT'
        or quick_review_metafield.filterAndSorting == 'FILTER_ONLY'
      %}
        <button
          type="button"
          class="quickreview-reviews__icon-btn"
          aria-label="Toggle filters"
          aria-expanded="false"
          @click="filtersOpen = !filtersOpen"
        >
          {% render 'svg', name: 'filter-bars' %}
        </button>
      {% endif %}
      {% if quick_review_metafield.filterAndSorting == 'FILTER_AND_SORT'
        or quick_review_metafield.filterAndSorting == 'SORTING_ONLY'
      %}
        <div class="quickreview-reviews__sort">
          <button
            type="button"
            class="quickreview-reviews__icon-btn"
            aria-label="Sort reviews"
            aria-expanded="false"
            @click="sortOpen = !sortOpen"
          >
            {% render 'svg', name: 'sort' %}
          </button>
          <ul class="quickreview-reviews__sort-menu" x-show="sortOpen">
            <template x-for="option in sortOptions" :key="option.value">
              <li
                value="option.value"
                class=""
                @click="setSort(option.value)"
                :class="{ 'is-active': option.value === activeSort }"
                x-text="option.label"
              ></li>
            </template>
          </ul>
        </div>
      {% endif %}
    </div>
  </div>
  <div x-show="filtersOpen" class="quickreview-reviews__filters" data-quickreview-filters>
    <span class="quickreview-reviews__filters-label">Filters</span>

    <div class="quickreview-reviews__rating-filter">
      <span class="quickreview-reviews__rating-label">Rating</span>

      <div class="quickreview-reviews__pills">
        <button
          type="button"
          class="quickreview-pill"
          :class="{ 'is-active': activeFilter == 'ALL' }"
          @click="setRatingFilter('ALL')"
        >
          All
        </button>
        <template x-for="rating in ratings" :key="rating">
          <button
            type="button"
            class="quickreview-pill"
            :class="{ 'is-active': Number(activeFilter) === rating }"
            @click="setRatingFilter(rating)"
          >
            <span x-text="rating"></span>
            <span class="quickreview-pill__star">
              {%- render 'icon', name: 'rating-star' -%}
            </span>
          </button>
        </template>
      </div>
    </div>
  </div>

  <div class="quickreview-reviews__list" data-quickreview-reviews-list>
    {% render 'quickreview-review-item', quick_review_metafield: quick_review_metafield %}
  </div>
</div>

<button type="button" class="quickreview-reviews__load-more" @click="loadMore()" x-show="hasMoreReviews()">
  Load more reviews
</button>
