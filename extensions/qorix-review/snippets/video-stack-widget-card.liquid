{% assign video_stack_metafield = app.metafields.qorix_review.video_stack.value %}

{% assign badge_color_val = badgeColor | default: video_stack_metafield.badgeColor | default: '#34C759' %}
{% assign overlay_tint_val = overlayTintColor | default: video_stack_metafield.overlayTintColor | default: '#1A1A1A' %}

{% assign show_star_dist = showStarDistribution %}
{% if show_star_dist == null %}
  {% assign show_star_dist = video_stack_metafield.showStarDistribution %}
{% endif %}

{% assign show_reviewer_name = showReviewerName %}
{% if show_reviewer_name == null %}
  {% assign show_reviewer_name = video_stack_metafield.showReviewerName %}
{% endif %}

{% assign show_review_text = showReviewTextBelow %}
{% if show_review_text == null %}
  {% assign show_review_text = video_stack_metafield.showReviewTextBelow %}
{% endif %}

{% assign show_verified = showVerifiedBadge %}
{% if show_verified == null %}
  {% assign show_verified = video_stack_metafield.showVerifiedBadge %}
{% endif %}

{% assign show_duration = showVideoDuration %}
{% if show_duration == null %}
  {% assign show_duration = video_stack_metafield.showVideoDuration %}
{% endif %}

{% assign show_product_name = showProductName %}
{% if show_product_name == null %}
  {% assign show_product_name = video_stack_metafield.showProductName %}
{% endif %}

{% assign loop_vid = loop_video %}
{% if loop_vid == null %}
  {% assign loop_vid = video_stack_metafield.showLoopVideo %}
{% endif %}

{% assign muted_vid = mutedByDefault %}
{% if muted_vid == null %}
  {% assign muted_vid = video_stack_metafield.mutedByDefault %}
{% endif %}
<template x-for="review in filteredReviews()" :key="review.id">
  <div class="qorix-review-video-stack-swiper-slide" x-show="!loading">
    <div
      class="qorix-review-video-stack-card"
      style="position: relative; overflow: hidden; transform-style: preserve-3d;"
    >
      <video
        class="qorix-review-video-stack-bg"
        :src="review.attachments?.find(a => a.type === 'VIDEO' || a.url?.match(/\.(mp4|webm|mov)$/i))?.url || review.video_url || '{{ video_src }}'"
        {% if loop_vid != false and loop_vid != 'false' %}
          loop
        {% endif %}
        playsinline
        {% if muted_vid != false and muted_vid != 'false' %}
          muted
        {% endif %}
        style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover; z-index: 1; transform: translateZ(0);"
      ></video>
      <div
        class="qorix-review-video-stack-overlay"
        style="position: absolute; bottom: 0; left: 0; right: 0; width: 100%; height: 60%; z-index: 50; pointer-events: none; transform: translateZ(10px); background-image: linear-gradient(180deg, rgba(0, 0, 0, 0) 30%, {{ overlay_tint_val }});"
      ></div>
      <div
        class="qorix-review-video-stack-topbar"
        style="position: absolute; z-index: 100; transform: translateZ(20px);"
      >
        {% if show_duration != false and show_duration != 'false' %}
          <div class="qorix-review-video-stack-pill">
            <span>0:00</span>
          </div>
        {% endif %}
        <button class="qorix-review-video-stack-play" aria-label="Play video">
          <svg width="10" height="12" viewBox="0 0 10 12" fill="none">
            <path d="M1 1L9 6L1 11V1Z" fill="#303030" />
          </svg>
        </button>
      </div>
      <div
        class="qorix-review-video-stack-info"
        style="position: absolute; bottom: 0; left: 0; right: 0; width: 100%; box-sizing: border-box; padding: 107px 16px 20px 16px; display: flex; flex-direction: column; gap: 8px; z-index: 100; transform: translateZ(20px); background-image: linear-gradient(180deg, rgba(0, 0, 0, 0) 30%, {{ overlay_tint_val }});"
      >
        {% if show_star_dist != false and show_star_dist != 'false' %}
          {% render 'stars',
            from: 'videoStack',
            starColor: video_stack_metafield.startColor,
            video_stack_metafield: video_stack_metafield
          %}
        {% endif %}
        <div class="qorix-review-video-stack-reviewer">
          {% if show_reviewer_name != false and show_reviewer_name != 'false' %}
            <span
              class="qorix-review-video-stack-name"
              x-text="review.reviewerName || '{{ reviewer_name | default: 'Anonymous' }}'"
            ></span>
          {% endif %}
          {% if show_verified %}
            <svg
              x-show="review.isVerified"
              width="18"
              height="18"
              viewBox="0 0 18 18"
              fill="none"
              aria-label="Verified"
            >
              <circle cx="9" cy="9" r="9" fill="{{ badge_color_val }}" />
              <path d="M5 9L7.5 11.5L13 6" stroke="white" stroke-width="1.8" stroke-linecap="round"
                stroke-linejoin="round" />
            </svg>
          {% endif %}
        </div>
        {% if show_review_text != false and show_review_text != 'false' %}
          <p
            class="qorix-review-video-stack-quote"
            x-text="review.body"
          ></p>
        {% endif %}
        {% if show_product_name != false and show_product_name != 'false' %}
          <a :href="`/products/${review.productHandle}`">
            <div class="qorix-review-video-stack-tag">
              <svg
                width="14px"
                height="14px"
                viewBox="0 0 24 24"
                fill="none"
                stroke="#303030"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M9 3h6v4H9z" />
                <path d="M6 7h12v14H6z" />
                <path d="M12 11v4" />
              </svg>
              <span x-text="review.productTitle"></span>
            </div>
          </a>
        {% endif %}
      </div>
    </div>
  </div>
</template>
<p
  x-show="filteredReviews().length === 0 && !loading"
  style="color: #888; font-size: 14px; padding: 20px 0"
>
  No reviews found.
</p>
