{{ 'quickreview-rating-summary.css' | asset_url | stylesheet_tag }}
<div class="quickreview-summary" data-quickreview-summary>
  <div class="quickreview-summary__score" data-quickreview-average>
    <span x-text="averageRating"></span>
    {% if quick_review_metafield.isShowReviewCount %}
      <span class="quickreview-summary__count" data-quickreview-count
        >( <span x-text="totalReviews"></span> reviews )</span
      >
    {% endif %}
  </div>
  <div class="quickreview-summary__stars" data-quickreview-stars aria-label="Rating">
    <template x-for="i in averageRating" :key="i">
      <span class="quickreview-star" :data-star-index="i">
        {%- render 'icon', name: 'rating-star' -%}
      </span>
    </template>
  </div>
  <button
    type="button"
    class="quickreview-summary__write-btn"
    data-quickreview-write-review
    @click="openModal()"
  >
    {{ quick_review_metafield.writeReviewButtonText }}
  </button>
</div>
