{{ 'quickreview-rating-bar.css' | asset_url | stylesheet_tag }}

<div x-show="reviews.length > 0 ? true : showRatingBarWithoutRating" class="quickreview-bar" data-quickreview-bar>
  <template x-for="star in [5, 4, 3, 2, 1]" :key="star">
    <div class="quickreview-bar__row" :data-star-level="star">
      <span class="quickreview-bar__label" x-text="`${star} star`"></span>

      <div class="quickreview-bar__track">
        <div
          class="quickreview-bar__fill"
          :data-quickreview-bar-fill="star"
          :style="`width: ${totalReviews ? ((starCount[star] / totalReviews) * 100).toFixed(1) : 0 }%`"
        ></div>
      </div>

      <span
        class="quickreview-bar__count"
        :data-quickreview-bar-count="star"
        x-text="starCount[star] ?? 0"
      ></span>
    </div>
  </template>
</div>
