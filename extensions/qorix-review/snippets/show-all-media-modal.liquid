{{ 'quickreview-media-modal.css' | asset_url | stylesheet_tag }}
<div x-data>
  <template x-teleport="body">
    <div
      class="quickreview-media-modal"
      data-quickreview-media-modal
      x-show="$store.qorixPopup.showAllMedia"
      style="display: none;"
      @keydown.escape.window="$store.qorixPopup.showAllMedia && window.QorixPopup.closeMediaModal()"
    >
      <div
        class="quickreview-media-modal__overlay"
        data-quickreview-media-modal-close
        @click="window.QorixPopup.closeMediaModal()"
      ></div>
      <div class="quickreview-media-modal__box">
        <div class="quickreview-media-modal__header">
          <p>Review With media</p>
          <button
            type="button"
            class="quickreview-media-modal__close"
            data-quickreview-media-modal-close
            aria-label="Close"
            @click="window.QorixPopup.closeMediaModal()"
            style="width: 32px; height: 32px; display: flex; align-items: center; justify-content: center; background: #ffffff; border: none; border-radius: 50%; box-shadow: 0 1px 6px rgba(0, 0, 0, 0.18); cursor: pointer; z-index: 2; padding: 0;"
          >
            {% render 'svg', name: 'close-x' %}
          </button>
        </div>
        <div class="quickreview-media-modal__body">
          <div class="quickreview-media-modal__grid" data-quickreview-media-modal-grid>
            <template x-if="$store.qorixPopup.attachments.length">
              <template x-for="attachment in $store.qorixPopup.attachments" :key="attachment.id">
                <div
                  class="quickreview-media-modal__item"
                  @click="window.QorixPopup.openLightbox(attachment); window.QorixPopup.closeMediaModal()"
                >
                  <template x-if="attachment.type === 'IMAGE'">
                    <img
                      :src="attachment.url"
                      alt="Review media"
                      width=""
                      height=""
                    >
                  </template>
                  <template x-if="attachment.type === 'VIDEO'">
                    <div style="width: 100%; height: 100%; position: relative;">
                      <video
                        class="qorix-qr-media-img"
                        :src="attachment.url + '#t=0.001'"
                        preload="metadata"
                        muted
                        playsinline
                        style="width: 100%; height: 100%; object-fit: cover;"
                      ></video>
                      <div
                        class="qorix-video-play-badge"
                        style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 32px; height: 32px; border-radius: 50%; background: rgba(255, 255, 255, 0.92); display: flex; align-items: center; justify-content: center; pointer-events: none; z-index: 2; box-shadow: 0 2px 8px rgba(0, 0, 0, 0.25);"
                      >
                        {% render 'svg', name: 'play-badge' %}
                      </div>
                    </div>
                  </template>
                </div>
              </template>
            </template>
          </div>
        </div>
      </div>
    </div>
  </template>
</div>
