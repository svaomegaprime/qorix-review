
<div class="qr-review-card">
  <div class="qr-review-header">
    <img
      src="{{ 'reviwer_img.png' | asset_url }}"
      alt="{{ reviewer_name }}"
      class="qr-review-avatar"
      width=""
      height=""
    >
    <div class="qr-review-meta">
      <div class="qr-review-name-row">
        <span class="qr-review-name">{{ reviewer_name }}</span>
        <span class="qr-verified-icon">{% render 'icon', name: 'check' %}</span>
      </div>
      <span class="qr-review-date">{{ review_date }}</span>
    </div>
  </div>

  <div class="qr-review-stars">
    {% render 'stars', rating: rating %}
  </div>

  <p class="qr-review-text">{{ review_text }}</p>

  <div class="qr-review-image-wrap qr-image-count-{{ image_count | at_most: 2 }}">
    {%- if image_count == 1 -%}
      {%- if media_1_type == 'video' and media_1_url != blank -%}
        <video
          class="qr-review-image qr-lightbox-trigger"
          data-type="video"
          data-src="{{ media_1_url }}"
          muted
          playsinline
          preload="metadata"
        ></video>
      {%- elsif media_1_url != blank -%}
        <img
          src="{{ media_1_url }}"
          alt="review image"
          class="qr-review-image qr-lightbox-trigger"
          data-type="image"
          data-src="{{ media_1_url }}"
          width=""
          height=""
        >
      {%- endif -%}

    {%- else -%}
      <div class="qr-review-image-single">
        {%- if media_1_type == 'video' -%}
          <video
            class="qr-lightbox-trigger"
            data-type="video"
            data-src="{{ media_1_url }}"
            muted
            playsinline
            preload="metadata"
          ></video>
        {%- else -%}
          <img
            src="{{ media_1_url }}"
            alt="review image"
            class="qr-lightbox-trigger"
            data-type="image"
            data-src="{{ media_1_url }}"
            width=""
            height=""
          >
        {%- endif -%}
      </div>

      <div class="qr-review-image-single">
        {%- if media_2_type == 'video' -%}
          <video
            class="qr-lightbox-trigger"
            data-type="video"
            data-src="{{ media_2_url }}"
            muted
            playsinline
            preload="metadata"
          ></video>
        {%- else -%}
          <img
            src="{{ media_2_url }}"
            alt="review image"
            class="qr-lightbox-trigger"
            data-type="image"
            data-src="{{ media_2_url }}"
            width=""
            height=""
          >
        {%- endif -%}

        {%- if image_count > 2 -%}
          <span class="qr-review-image-count">+{{ image_count | minus: 2 }}</span>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>

  <div class="qr-review-tag">
    <span class="qr-tag-icon"
      ><img src="{{ 'review_tag.png' | asset_url }}" alt="review tag img" width="23" height="23"
    ></span>
    {{ product_tag }}
  </div>

  <div class="qr-review-actions">
    <button class="qr-helpful-btn" type="button">
      <span class="qr-thumb-icon">
        {% render 'icon', name: 'thumbs-up' %}
      </span>
      Helpful ({{ helpful_count }})
    </button>
    <button class="qr-share-btn" type="button">
      <span class="qr-share-icon">
        {% render 'icon', name: 'share' %}
      </span>
      Share
    </button>
  </div>
</div>
