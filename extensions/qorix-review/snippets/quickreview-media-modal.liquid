{{ 'quickreview-media-modal.css' | asset_url | stylesheet_tag }}
<div class="quickreview-media-modal" data-quickreview-media-modal x-show="showAllMedia">
  <div class="quickreview-media-modal__overlay" data-quickreview-media-modal-close></div>

  <div class="quickreview-media-modal__box">
    <button
      type="button"
      class="quickreview-media-modal__close"
      data-quickreview-media-modal-close
      aria-label="Close"
      @click="showAllMedia = false"
    >
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M5 5L19 19M19 5L5 19" stroke="#4A4A4A" stroke-width="2.2" stroke-linecap="round"/>
      </svg>
    </button>

    <div class="quickreview-media-modal__body">
      <div class="quickreview-media-modal__grid" data-quickreview-media-modal-grid>
        <template x-if="attachments?.length">
          <template x-for="attachment in attachments" :key="attachment.id">
            <template x-if="attachment.type === 'IMAGE'">
              <div class="quickreview-media-modal__item" @click="openLightbox(attachment); showAllMedia = false">
                <img
                  :src="attachment.url"
                  alt="Review media"
                  loading="lazy"
                  width=""
                  height=""
                >
              </div>
            </template>

            <template x-if="attachment.type === 'VIDEO'">
              <div class="quickreview-media-modal__item" @click="openLightbox(attachment); showAllMedia = false">
                <video
                  class="quickreview-media__img"
                  :src="attachment.url"
                  preload="metadata"
                ></video>
              </div>
            </template>
          </template>
        </template>
      </div>
    </div>
  </div>
</div>
