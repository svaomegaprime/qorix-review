<div class="qr-filters-bar">
  {% if review_hub_metafield.filterSorting == 'FILTER_AND_SORTING'
    or review_hub_metafield.filterSorting == 'FILTER_ONLY'
  %}
    <button class="qr-filter-btn" type="button" @click="filtersOpen = !filtersOpen">
      <span class="qr-filter-icon">{% render 'icon', name: 'filter' %}</span>
      Filter
      <span>
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M6.24009 8.2C6.31232 8.13302 6.39703 8.08092 6.48939 8.04668C6.58175 8.01244 6.67995 7.99673 6.77838 8.00044C6.87681 8.00416 6.97355 8.02722 7.06307 8.06833C7.15258 8.10943 7.23313 8.16777 7.30009 8.24L10.0001 11.148L12.7001 8.24C12.8354 8.09413 13.023 8.00797 13.2218 8.00047C13.4206 7.99297 13.6142 8.06474 13.7601 8.2C13.906 8.33526 13.9921 8.52293 13.9996 8.72172C14.0071 8.92051 13.9354 9.11413 13.8001 9.26L10.5501 12.76C10.4799 12.8357 10.3948 12.8961 10.3002 12.9375C10.2055 12.9788 10.1034 13.0001 10.0001 13.0001C9.89683 13.0001 9.79467 12.9788 9.70003 12.9375C9.60539 12.8961 9.5203 12.8357 9.45009 12.76L6.20009 9.26C6.13311 9.18778 6.08101 9.10307 6.04677 9.01071C6.01253 8.91835 5.99682 8.82015 6.00053 8.72172C6.00425 8.62328 6.02732 8.52655 6.06842 8.43703C6.10952 8.34752 6.16786 8.26697 6.24009 8.2Z" fill="#4A4A4A"/>
        </svg>
      </span>
    </button>
  {% endif %}
  {% if review_hub_metafield.filterSorting == 'FILTER_AND_SORTING'
    or review_hub_metafield.filterSorting == 'SORTING_ONLY'
  %}
    <div class="qr-sort-dropdown">
      <button class="qr-sort-btn" @click="sortOpen = !sortOpen">
        <span class="qr-sort-btn-text">Sort by: <span x-text="getSortLabel()"></span></span>
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path fill-rule="evenodd" clip-rule="evenodd"
              d="M6.24009 8.2C6.31232 8.13302 6.39703 8.08092 6.48939 8.04668C6.58175 8.01244 6.67995 7.99673 6.77838 8.00044C6.87681 8.00416 6.97355 8.02722 7.06307 8.06833C7.15258 8.10943 7.23313 8.16777 7.30009 8.24L10.0001 11.148L12.7001 8.24C12.8354 8.09413 13.023 8.00797 13.2218 8.00047C13.4206 7.99297 13.6142 8.06474 13.7601 8.2C13.906 8.33526 13.9921 8.52293 13.9996 8.72172C14.0071 8.92051 13.9354 9.11413 13.8001 9.26L10.5501 12.76C10.4799 12.8357 10.3948 12.8961 10.3002 12.9375C10.2055 12.9788 10.1034 13.0001 10.0001 13.0001C9.89683 13.0001 9.79467 12.9788 9.70003 12.9375C9.60539 12.8961 9.5203 12.8357 9.45009 12.76L6.20009 9.26C6.13311 9.18778 6.08101 9.10307 6.04677 9.01071C6.01253 8.91835 5.99682 8.82015 6.00053 8.72172C6.00425 8.62328 6.02732 8.52655 6.06842 8.43703C6.10952 8.34752 6.16786 8.26697 6.24009 8.2Z"
              fill="#4A4A4A" />
        </svg>
      </button>
      <ul class="qr-sort-menu" x-show="sortOpen">
        <template x-for="option in sortOptions" :key="option.value">
          <li
            value="option.value"
            class=""
            @click="setSort(option.value)"
            :class="{ 'is-active': option.value === activeSort }"
            x-text="option.label"
          ></li>
        </template>
      </ul>
    </div>
  {% endif %}
</div>
{% if review_hub_metafield.filterSorting == 'FILTER_AND_SORTING'
  or review_hub_metafield.filterSorting == 'FILTER_ONLY'
%}
  <div class="qr-rating-filter" x-show="filtersOpen">
    <span class="qr-rating-label">Rating</span>
    <div class="qr-rating-pills">
      <button
        type="button"
        class="qr-pill"
        :class="{ 'qr-pill-active': activeFilter == 'ALL' }"
        @click="setRatingFilter('ALL')"
      >
        All
      </button>
      <template x-for="rating in ratings" :key="rating">
        <button
          type="button"
          class="qr-pill"
          :class="{ 'qr-pill-active': Number(activeFilter) === rating }"
          @click="setRatingFilter(rating)"
        >
          <span x-text="rating"></span>
          {%- render 'icon', name: 'star' -%}
        </button>
      </template>
    </div>
  </div>
{% endif %}
