{% assign icon_color = quoteIconColor | default: '#088728' %}
{% assign verified_badge_color = verifiedBageColor | default: verifiedBadgeColor | default: '#088728' %}
{% assign max_len = textLength | plus: 0 %}
{% render 'skeleton', type: 'card', grid_columns: 3 %}
<template x-for="review in filteredReviews()" :key="review.id">
  <div class="swiper-slide" x-show="!loading">
    <div
      class="qr-review-card"
      style="--card-bg: {{ cardBackgroundColor }};{% if textColor != blank %} --card-text-color: {{ textColor }}; color: {{ textColor }};{% endif %}"
    >
      <div class="qr-card-content">
        {% if showQuoteMarkIcon != false and showQuoteMarkIcon != 'false' %}
          <div class="qr-quote-icon">
            {% render 'svg', name: 'quote', color: icon_color %}
          </div>
        {% endif %}

        <div class="qr-review-text">
          <p
            x-text="{% if max_len > 0 %}review.body && review.body.length > {{ max_len }} ? review.body.slice(0, {{ max_len }}) + '...' : review.body{% else %}review.body{% endif %}"
            style="{% if quoteFontSize != blank %}font-size: {{ quoteFontSize }}px;{% endif %}{% if textColor != blank %}color: {{ textColor }};{% endif %}"
          ></p>
        </div>

        {% if showStarDistribution != false and showStarDistribution != 'false' %}
          <div class="qr-review-stars">
            {% render 'stars',
              from: 'quoteloopReview',
              starColor: starColor,
              quote_loop_metafield: quote_loop_metafield
            %}
          </div>
        {% endif %}
      </div>

      <div class="qr-review-footer">
        {% if showMediaAsset %}
          <img
            x-show="review.reviewerImage"
            src="{{ avatar | asset_url }}"
            class="qr-reviewer-avatar"
            alt="{{ name }}"
            width="56"
            height="56"
          >

          <span
            x-show="!review.reviewerImage"
            class="qr-review-avatar"
            x-show="true"
            x-text="review.reviewerName[0].toUpperCase()"
            style="font-size: 18px;"
          ></span>
        {% endif %}

        <div class="qr-reviewer-info">
          {% if showReviewerName != false and showReviewerName != 'false' %}
            <span
              class="qr-reviewer-name"
              {% if textColor != blank %}
                style="color: {{ textColor }};"
              {% endif %}
            >
              <span x-text="review.reviewerName"></span>
              {% if showVerifiedBadge != false and showVerifiedBadge != 'false' %}
                <span x-show="review.isVerified">
                  {% render 'svg', name: 'check', color: verified_badge_color %}
                </span>
              {% endif %}
            </span>
          {% endif %}
          {% if showProductName != false and showProductName != 'false' %}
            <span
              class="qr-reviewer-product"
              {% if textColor != blank %}
                style="color: {{ textColor }}; opacity: 0.8;"
              {% endif %}
              x-text="review.productTitle"
            >
            </span>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</template>
<p
  x-show="filteredReviews().length === 0 && !loading"
  style="color: #888; font-size: 16px; padding: 20px 0"
>
  No reviews found
</p>
