{{ 'quickreview-review-item.css' | asset_url | stylesheet_tag }}

{% render 'skeleton', type: 'list' %}
<template x-for="review in filteredReviews()" :key="review.id">
  <div class="quickreview-review" x-show="!loading">
    <div class="quickreview-review__head">
      {% if quick_review_metafield.isShowReviewerName %}
        <div x-show="review.reviewerName" class="quickreview-review__avatar">
          <img
            x-show="review.reviewerImage"
            :src="review.reviewerImage"
            :alt="review.reviewerName"
            height="60"
            width="60"
          >
          <span
            x-show="!review.reviewerImage"
            x-text="review.reviewerName ? review.reviewerName[0].toUpperCase() : ''"
            style="font-size: 18px;"
          ></span>
        </div>
      {% endif %}

      <div class="quickreview-review__meta">
        {% if quick_review_metafield.isShowReviewerName %}
          <div style="display: flex; gap:9px;">
            <span class="quickreview-review__author" x-text="review.reviewerName"></span>
            {% if quick_review_metafield.isShowVerifiedBadge %}
              <span x-show="review.isVerified" class="qr-quick-review-verified-check">
                <svg width="16" height="16" viewBox="0 0 512 512">
                  <path d="M256 0C114.6 0 0 114.6 0 256s114.6 256 256 256s256-114.6 256-256S397.4 0 256 0zM371.1 204.1l-128 128c-6.3 6.3-16.4 6.3-22.6 0l-64-64c-6.3-6.3-6.3-16.4 0-22.6s16.4-6.3 22.6 0L232 297.4l116.5-116.5c6.3-6.3 16.4-6.3 22.6 0s6.3 16.4 0 22.6z"></path>
                </svg>
              </span>
            {% endif %}
          </div>
        {% endif %}
        {% if quick_review_metafield.isShowReviewDate %}
          <span class="quickreview-review__date" x-text="timeAgo(review.createdAt)"></span>
        {% endif %}
      </div>
    </div>
    {% if quick_review_metafield.isShowStarRatingOnCard %}
      <div class="quickreview-review__stars">
        <template x-for="i in 5" :key="i">
          <span>
            <template x-if="i <= review.rating">
              <span class="review-star-color">
                {% render 'icon', name: 'rating-star' %}
              </span>
            </template>
            <template x-if="i > review.rating">
              {% render 'icon', name: 'rating-star-withoutfield' %}
            </template>
          </span>
        </template>
      </div>
    {% endif %}
    {% if quick_review_metafield.isShowProductName %}
      <h3 class="quickreview-review__product" x-text="review.productTitle"></h3>
    {% endif %}
    <p class="quickreview-review__body" x-text="review.body"></p>

    <div class="quickreview-review__reply" x-show="review?.reply?.body">
      <h6>Reply</h6>
      <p x-text="review?.reply?.body"></p>
    </div>

    {% if quick_review_metafield.isShowMediaThumbnails %}
      <div class="quickreview-review__media" x-show="review.attachments.length > 0">
        <template x-for="attachment in review.attachments" :key="attachment.id">
          <div class="quickreview-review__media-item" @click="openLightbox(attachment)">
            <template x-if="attachment.type === 'IMAGE'">
              <img
                class="quickreview-review__media-img"
                :src="attachment.url"
                alt="Review media"
                width=""
                height=""
              >
            </template>

            <template x-if="attachment.type === 'VIDEO'">
              <div style="position: relative; width: 100%; height: 100%;">
                <video
                  class="quickreview-review__media-img"
                  :src="attachment.url + '#t=0.001'"
                  preload="metadata"
                  muted
                  playsinline
                ></video>
                <div class="qorix-video-play-badge" style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 32px; height: 32px; border-radius: 50%; background: rgba(255, 255, 255, 0.92); display: flex; align-items: center; justify-content: center; pointer-events: none; z-index: 2; box-shadow: 0 2px 8px rgba(0, 0, 0, 0.25);">
                  <svg width="12" height="14" viewBox="0 0 12 14" fill="none" xmlns="http://www.w3.org/2000/svg" style="width: 12px; height: 14px; margin-left: 2px; display: block;">
                    <path d="M3 2.5L10.5 7L3 11.5V2.5Z" fill="#1A1A1A"/>
                  </svg>
                </div>
              </div>
            </template>
          </div>
        </template>
      </div>
    {% endif %}

    {% if quick_review_metafield.isShowHelpfulButton %}
      <div class="quickreview-review__footer">
        <button
          type="button"
          class="quickreview-review__helpful"
          :class="{ 'is-helpful': review.isHelpful }"
          data-quickreview-review-helpful
          :aria-pressed="review.isHelpful ? 'true' : 'false'"
          @click="helpfulToggle(review, '{{ customer.id }}', '{{ customer.email }}')"
        >
          {% render 'helpful-icon' %}
          Helpful (<span data-quickreview-review-helpful-count x-text="review.helpfulTotal || 0">0</span>)
        </button>
      </div>
    {% endif %}
  </div>
</template>
<div
  x-show="filteredReviews().length === 0 && !loading"
  style="padding-bottom:20px; color: #666;  margin-top: 20px;"
>
  {% comment %} <p style="font-size: 16px; margin: 0; font-weight: 500; color: #303030;">No reviews found</p> {% endcomment %}
  <p>No reviews found</p>
</div>
