enum ReviewCheckStatus {
    SENT
    OPENED
    PENDING
    REVIEWED
    FAILED
}

enum RequestType {
    AUTOMATIC
    MANUAL
    REMINDER
}

model Order {
    id      String @id @default(uuid()) @db.Uuid()
    storeId String
    store   Store  @relation(fields: [storeId], references: [storeGID], onDelete: Cascade)
    orderId String

    fulfillmentStatus String
    paymentStatus     String
    userEmail         String?
    productsJson      Json?
    reviewCheckStatus ReviewCheckStatus @default(PENDING)
    requestType       RequestType       @default(AUTOMATIC)
    totalPrice        String?
    currency          String?

    redisBullmqJobId Json? //  {reviewRequestId: string, reminderJobId: string}

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([storeId, orderId])
}
