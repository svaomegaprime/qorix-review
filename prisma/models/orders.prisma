model Order {
  id                String            @id @default(uuid()) @db.Uuid
  storeId           String
  orderId           String
  fulfillmentStatus String
  paymentStatus     String
  userEmail         String?
  reviewCheckStatus ReviewCheckStatus @default(PENDING)
  requestType       RequestType       @default(AUTOMATIC)
  totalPrice        String?
  currency          String?
  redisBullmqJobId  Json?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  store             Store             @relation(fields: [storeId], references: [storeGID], onDelete: Cascade)
  lineItems         OrderLineItem[]
  reviews           Review[]

  @@unique([storeId, orderId])
}

model OrderLineItem {
  id         String   @id @default(uuid()) @db.Uuid
  orderId    String   @db.Uuid
  productId  String
  title      String
  quantity   Int
  handle     String?
  url        String?
  image      String?
  isReviewed Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, productId])
}

enum ReviewCheckStatus {
  SENT
  OPENED
  PENDING
  REVIEWED
  FAILED
}

enum RequestType {
  AUTOMATIC
  MANUAL
  REMINDER
}
