enum ReviewCheckStatus {
    SENT
    OPENED
    PANDING
    REVIEWED
    FAILED
}

model Order {
    id      String @id @default(uuid()) @db.Uuid()
    storeId String
    store   Store  @relation(fields: [storeId], references: [storeGID], onDelete: Cascade)
    orderId String

    fulfillmentStatus String
    paymentStatus     String
    userEmail         String?
    projuctJson       Json?
    reviewCheckStatus ReviewCheckStatus @default(PANDING)
    totalPrice        String?
    currency          String?

    redisBullmqJobId Json? //  {reviewRequestId: string, reminderJobId: string}

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([storeId, orderId])
}
