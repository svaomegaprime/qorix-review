enum ReviewCheckStatus {
    SENT
    OPENED
    PENDING
    REVIEWED
    FAILED
}

enum RequestType {
    AUTOMATIC
    MANUAL
    REMINDER
}

model Order {
    id      String @id @default(uuid()) @db.Uuid()
    storeId String
    store   Store  @relation(fields: [storeId], references: [storeGID], onDelete: Cascade)
    orderId String

    fulfillmentStatus String
    paymentStatus     String
    userEmail         String?
    reviewCheckStatus ReviewCheckStatus @default(PENDING)
    requestType       RequestType       @default(AUTOMATIC)
    totalPrice        String?
    currency          String?

    redisBullmqJobId Json? //  {reviewRequestId: string, reminderJobId: string}

    lineItems        OrderLineItem[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([storeId, orderId])
}

model OrderLineItem {
    id         String   @id @default(uuid()) @db.Uuid()
    orderId    String   @db.Uuid()
    order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
    productId  String
    title      String
    quantity   Int
    handle     String?
    url        String?
    image      String?
    isReviewed Boolean  @default(false)
    createdAt  DateTime @default(now())
    updatedAt  DateTime @updatedAt

    @@unique([orderId, productId])
}
