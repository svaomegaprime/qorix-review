model TrustBarWidget {
  id        String   @id @default(uuid()) @db.Uuid
  storeId   String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  store     Store    @relation(fields: [storeId], references: [storeGID], onDelete: Cascade)
}

model QuickReviewWidget {
  id                       String   @id @default(uuid()) @db.Uuid
  storeId                  String   @unique
  isShowNameField          Boolean  @default(true)
  isShowEmailField         Boolean  @default(true)
  isPhotoUpload            Boolean  @default(true)
  isVideoUpload            Boolean  @default(true)
  isshowMediaImageAndVideo Boolean  @default(true)
  formTitle                String   @default("How was your experience?")
  formSubtitle             String   @default("Your feedback helps others")
  submitButtonText         String   @default("Submit review")
  successMessageTitle      String   @default("Review submitted!")
  successButtonText        String   @default("Continue Shopping")
  successMessage           String   @default("Thank you for your review. It has been submitted successfully.")
  starColor                String?  @default("#f59e0b")
  buttonBackgroundColor    String?  @default("#1D9E75")
  buttonTextColor          String?  @default("#fff")
  verifiedBadgeColor       String?  @default("#1D9E75")
  barFileColor             String?  @default("#34C759")
  borderRadius             String   @default("15px")
  isShowReviewerName       Boolean  @default(true)
  isShowReviewerImage      Boolean  @default(true)
  isShowReviewerVideo      Boolean  @default(true)
  isShowProductName        Boolean  @default(true)
  isShowVerifiedBadge      Boolean  @default(true)
  isShowReviewDate         Boolean  @default(true)
  isShowRatingFilter       Boolean  @default(true)
  isShowStarDistribution   Boolean  @default(true)
  isShowMediaStrip         Boolean  @default(true)
  isShowReviewCount        Boolean  @default(true)
  writeReviewButtonText    String   @default("Write a review")
  showHelfullButton        Boolean  @default(true)
  filterAndSorting         String   @default("FILTER_AND_SORTING")
  reviewPerPage            Int      @default(10)
  defaultSort              String   @default("MOST_RECENT")
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  store                    Store    @relation(fields: [storeId], references: [storeGID], onDelete: Cascade)
}

model QuoteLoopWidget {
  id      String @id @default(uuid()) @db.Uuid
  storeId String @unique
  store   Store  @relation(fields: [storeId], references: [storeGID], onDelete: Cascade)

  // Header option
  showHeader   Boolean @default(true)
  headerStyle  String  @default("center")
  eyebrowLabel String  @default("CUSTOMER REVIEWS")
  heading      String  @default("Reviews from people")
  subheading   String  @default("Watch and hear what our customers have to say.")
  reviewStats  String  @default("Show review count & verified badge")

  // Display elements and loop behavior
  showStarDistribution   Boolean @default(true)
  showReviewerName       Boolean @default(true)
  showQuoteMarkIcon      Boolean @default(true)
  showVerifiedBadge      Boolean @default(true)
  showMediaAsset         Boolean @default(true)
  showArrowControls      Boolean @default(true)
  showProductName        Boolean @default(true)
  autoSlider             Boolean @default(false)
  showAppreciationOption Boolean @default(true)
  speed                  Int     @default(450)

  filterSorting    String @default("Filter & sorting both")
  fiteringMinStart String @default("3 star and above")

  // Colors
  starColor           String @default("#F59E0B")
  textColor           String @default("#303030")
  quoteMarkColor      String @default("#1D9E75")
  cardBackgroundColor String @default("#FFFFFF")

  // Typography
  quoteFontSize Int    @default(24)
  textLength    Int    @default(160)
  advanceCss    String @default("")

  quoteLoopWidgetSettings Json? @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ReviewHubWidget {
  id String @id @default(uuid()) @db.Uuid

  storeId String @unique
  store   Store  @relation(fields: [storeId], references: [storeGID], onDelete: Cascade)

  // Header option
  showHeader   Boolean @default(true)
  headerStyle  String  @default("center")
  eyebrowLabel String  @default("CUSTOMER REVIEWS")
  heading      String  @default("Reviews from people")
  subheading   String  @default("Watch and hear what our customers have to say.")
  reviewStats  String  @default("Show review count & verified badge")

  // Display elements
  showStarDistribution   Boolean @default(true)
  showReviewerName       Boolean @default(true)
  showReviewTimer        Boolean @default(true)
  showVerifiedBadge      Boolean @default(true)
  showMediaAsset         Boolean @default(true)
  showShareOption        Boolean @default(true)
  showAppreciationOption Boolean @default(true)

  // Carousel behavior
  layout         String @default("3 column grid")
  filterSorting  String @default("FILTER_AND_SORTING")
  reviewsPerPage Int    @default(6)

  // Colors
  starColor           String @default("#34C759")
  textColor           String @default("#1A1A1A")
  verifiedBadgeColor  String @default("#1D9E75")
  cardBackgroundColor String @default("#FFFFFF")
  borderColor         String @default("#F0F0F0")
  filterChipColor     String @default("#108848")
  filterChipStarColor String @default("#FFFFFF")

  // Advanced CSS
  advanceCss String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
