// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model Store {
  id         String @id @default(uuid()) @db.Uuid()
  storeGID   String @unique 
  storeURL   String
  storeEmail String

  reviews         Review[]
  subscription    Subscription?
  trustBarWidgets TrustBarWidget?
  storeSettings   StoreSettings?
  quickReviewWidget QuickReviewWidget?

  createdAt       DateTime         @default(now())
  updatedAt       DateTime?        @updatedAt
}

model Subscription {
  id String @id @default(uuid()) @db.Uuid()

  storeId String @unique
  store   Store  @relation(fields: [storeId], references: [storeGID], onDelete: Cascade)

  plan           PlanType  @default(FREE)
  planHandle     String?
  subscriptionId String?
  status         String
  trialEndsAt    DateTime?
  startsAt       DateTime?
  endsAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([plan])
}






// Start--- Enums

enum PlanType {
  FREE
  BASIC
  PRO
}

enum ReviewStatus {
  PENDING
  PUBLISHED
  REJECTED
  SPAM
  ARCHIVE
}

enum ReviewSource {
  DEMO
  REQUEST_EMAIL
  PRODUCT_PAGE
}

enum ReviewSortOrder {
  RECENT
  RATED
  HELPFUL
}

enum MinimumStarRatingToDisplay {
  ALL_RATINGS
  ONE_STAR
  TWO_STAR
  THREE_STAR
  FOUR_STAR
  FIVE_STAR
}

enum AttachmentType {
  VIDEO
  IMAGE
}

enum AutoPublishRules {
  AUTO_PUBLISH
  VERIFIED_ONLY
  MANUAL_PUBLISH
}

// End--- Enums
