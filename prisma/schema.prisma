generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model Store {
  id                 String              @id @default(uuid()) @db.Uuid
  storeGID           String              @unique
  storeURL           String
  storeEmail         String
  createdAt          DateTime            @default(now())
  updatedAt          DateTime?           @updatedAt
  order              Order[]
  quickReviewWidget  QuickReviewWidget?
  quoteLoopWidget    QuoteLoopWidget?
  reviews            Review[]
  reviewHubWidget    ReviewHubWidget?
  reviewReelSettings ReviewReelSettings?
  storeSettings      StoreSettings?
  subscription       Subscription?
  trustBarWidgets    TrustBarWidget?
  videoStackSettings VideoStackSettings?
}

model Subscription {
  id               String    @id @default(uuid()) @db.Uuid
  storeId          String    @unique
  plan             PlanType  @default(FREE)
  planHandle       String?
  subscriptionId   String?
  status           String
  trialEndsAt      DateTime?
  startsAt         DateTime?
  endsAt           DateTime?
  externalSettings Json?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  store            Store     @relation(fields: [storeId], references: [storeGID], onDelete: Cascade)

  @@index([plan])
}

enum PlanType {
  FREE
  BASIC
  PRO
}

enum ReviewStatus {
  PENDING
  PUBLISHED
  REJECTED
  SPAM
  ARCHIVE
}

enum ReviewSource {
  DEMO
  REQUEST_EMAIL
  PRODUCT_PAGE
}

enum ReviewSortOrder {
  RECENT
  RATED
  HELPFUL
}

enum MinimumStarRatingToDisplay {
  ALL_RATINGS
  ONE_STAR
  TWO_STAR
  THREE_STAR
  FOUR_STAR
  FIVE_STAR
}

enum AttachmentType {
  VIDEO
  IMAGE
}

enum AutoPublishRules {
  AUTO_PUBLISH
  VERIFIED_ONLY
  MANUAL_PUBLISH
}
