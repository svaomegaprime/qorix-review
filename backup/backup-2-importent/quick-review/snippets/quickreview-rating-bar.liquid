{{ 'quickreview-rating-bar.css' | asset_url | stylesheet_tag }}
<div class="quickreview-bar" data-quickreview-bar>

  <div class="quickreview-bar__row" data-star-level="5">
    <span class="quickreview-bar__label">5 star</span>
    <div class="quickreview-bar__track">
      <div class="quickreview-bar__fill" data-quickreview-bar-fill="5" style="width: 85%;"></div>
    </div>
    <span class="quickreview-bar__count" data-quickreview-bar-count="5">116</span>
  </div>

  <div class="quickreview-bar__row" data-star-level="4">
    <span class="quickreview-bar__label">4 star</span>
    <div class="quickreview-bar__track">
      <div class="quickreview-bar__fill" data-quickreview-bar-fill="4" style="width: 67%;"></div>
    </div>
    <span class="quickreview-bar__count" data-quickreview-bar-count="4">92</span>
  </div>

  <div class="quickreview-bar__row" data-star-level="3">
    <span class="quickreview-bar__label">3 star</span>
    <div class="quickreview-bar__track">
      <div class="quickreview-bar__fill" data-quickreview-bar-fill="3" style="width: 49%;"></div>
    </div>
    <span class="quickreview-bar__count" data-quickreview-bar-count="3">67</span>
  </div>

  <div class="quickreview-bar__row" data-star-level="2">
    <span class="quickreview-bar__label">2 star</span>
    <div class="quickreview-bar__track">
      <div class="quickreview-bar__fill" data-quickreview-bar-fill="2" style="width: 32%;"></div>
    </div>
    <span class="quickreview-bar__count" data-quickreview-bar-count="2">44</span>
  </div>

  <div class="quickreview-bar__row" data-star-level="1">
    <span class="quickreview-bar__label">1 star</span>
    <div class="quickreview-bar__track">
      <div class="quickreview-bar__fill" data-quickreview-bar-fill="1" style="width: 17%;"></div>
    </div>
    <span class="quickreview-bar__count" data-quickreview-bar-count="1">23</span>
  </div>

</div>