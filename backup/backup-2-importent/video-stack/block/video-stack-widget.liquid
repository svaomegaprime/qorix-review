{{ 'swiper-bundle.min.css' | asset_url | stylesheet_tag }}
{{ 'video-stack-widget.css' | asset_url | stylesheet_tag }}

<style>
  [data-section="qorix-review-video-stack-widget"] {
    --nav-cols: {{ block.settings.nav_cols | default: 5 }};
  }
</style>

<section class="qorix-review-video-stack-section" data-section="qorix-review-video-stack-widget">
  {% render 'heading',
    label: block.settings.label,
    title: block.settings.title,
    subtitle: block.settings.subtitle,
    rating: block.settings.rating,
    review_count: block.settings.review_count
  %}

  <!-- ════════ CAROUSEL ════════ -->
  <div class="qorix-review-video-stack-carousel">
    <!-- Inner clip wrapper hides the outermost half-cards -->
    <div class="qorix-review-video-stack-swiper-clip">
      <div class="qorix-review-video-stack-swiper">
        <div class="qorix-review-video-stack-swiper-wrapper">
          {% render 'video-stack-widget-card',
            video_src: 'https://www.pexels.com/download/video/7667953/',
            rating: 5,
            reviewer_name: 'Ava Rajib.',
            verified: true,
            review_quote: 'My skin has never felt better...',
            loop_video: true
          %}
          {% render 'video-stack-widget-card',
            video_src: '',
            rating: 1,
            reviewer_name: 'Ava Rubina.',
            verified: true,
            review_quote: 'My skin has never felt better...',
            loop_video: true
          %}
          {% render 'video-stack-widget-card',
            video_src: '',
            rating: 1,
            reviewer_name: 'Ava Rubina.',
            verified: true,
            review_quote: 'My skin has never felt better...',
            loop_video: true
          %}
          {% render 'video-stack-widget-card',
            video_src: '',
            rating: 1,
            reviewer_name: 'Ava Rubina.',
            verified: true,
            review_quote: 'My skin has never felt better...',
            loop_video: true
          %}
          {% render 'video-stack-widget-card',
            video_src: '',
            rating: 1,
            reviewer_name: 'Ava Rubina.',
            verified: true,
            review_quote: 'My skin has never felt better...',
            loop_video: true
          %}
          {% render 'video-stack-widget-card',
            video_src: 'https://www.pexels.com/download/video/7667953/',
            rating: 3,
            reviewer_name: 'Ava adam.',
            verified: true,
            review_quote: 'My skin has never felt better. Love it!',
            product_tag: 'Hydrating serum',
            loop_video: true
          %}

          {% render 'video-stack-widget-card',
            video_src: 'https://www.pexels.com/download/video/7667953/',
            rating: 5,
            reviewer_name: 'Ava Rokeya.',
            verified: true,
            review_quote: 'My skin has never felt better. Love it!',
            loop_video: true
          %}

          {% render 'video-stack-widget-card',
            video_src: 'https://www.pexels.com/download/video/7667953/',
            rating: 3,
            reviewer_name: 'Ava Rajina.',
            verified: true,
            review_quote: 'My skin has never felt better. Love it!',
            loop_video: true
          %}

          {% render 'video-stack-widget-card',
            video_src: 'https://www.pexels.com/download/video/7667953/',
            rating: 1,
            reviewer_name: 'Ava Rubina.',
            verified: true,
            review_quote: 'My skin has never felt better...',
            loop_video: true
          %}
        </div>
        <!-- /.swiper-wrapper -->
      </div>
      <!-- /.swiper -->
    </div>
    <!-- /.qorix-review-video-stack-swiper-clip -->

    <div class="qorix-review-video-stack-custom-pagination"></div>

    <!-- Navigation arrows -->
    <button class="qorix-review-video-stack-nav qorix-review-video-stack-nav-prev" aria-label="Previous slide">
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
        <path fill-rule="evenodd" clip-rule="evenodd"
          d="M12.2805 14.53C12.4209 14.3894 12.4998 14.1987 12.4998 14C12.4998 13.8012 12.4209 13.6106 12.2805 13.47L8.81047 10 12.2805 6.53C12.4209 6.3894 12.4998 6.1987 12.4998 6C12.4998 5.5858 12.1637 5.25 11.7505 5.25C11.5517 5.25 11.3611 5.3296 11.2205 5.47L7.22047 9.47C7.08002 9.6106 7.00113 9.8012 7.00113 10C7.00113 10.1987 7.08002 10.3894 7.22047 10.53L11.2205 14.53C11.3611 14.6704 11.5517 14.7493 11.7505 14.7493C11.9492 14.7493 12.1398 14.6704 12.2805 14.53Z"
          fill="#4A4A4A" />
      </svg>
    </button>

    <button class="qorix-review-video-stack-nav qorix-review-video-stack-nav-next" aria-label="Next slide">
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
        <path fill-rule="evenodd" clip-rule="evenodd"
          d="M7.71953 14.53C7.57908 14.3894 7.50019 14.1987 7.50019 14C7.50019 13.8012 7.57908 13.6106 7.71953 13.47L11.1895 10 7.71953 6.53C7.57908 6.3894 7.50019 6.1987 7.50019 6C7.50019 5.5858 7.83597 5.25 8.24953 5.25C8.44828 5.25 8.63891 5.3296 8.77953 5.47L12.7795 9.47C12.92 9.6106 12.9989 9.8012 12.9989 10C12.9989 10.1987 12.92 10.3894 12.7795 10.53L8.77953 14.53C8.63891 14.6704 8.44828 14.7493 8.24953 14.7493C8.05078 14.7493 7.86016 14.6704 7.71953 14.53Z"
          fill="#4A4A4A" />
      </svg>
    </button>
  </div>
  <!-- /.qorix-review-video-stack-carousel -->
</section>
<script src="{{ 'swiper-bundle.min.js' | asset_url }}" defer></script>
<script src="{{ 'video-stack-widget.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Qorix Video Stack",
  "target": "section",
  "settings": [
    { "type": "product", "id": "product", "label": "product", "autofill": true },
    { "type": "color", "id": "colour", "label": "Star Colour", "default": "#ff0000" },
    { "type": "range", "id": "nav_cols", "label": "Number of columns", "min": 3, "max": 7, "step": 1, "default": 5 }
  ]
}
{% endschema %}
