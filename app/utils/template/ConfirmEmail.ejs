<%
const {
  subject = "Email Confirmation",
  logo = "",
  tagline = "",
  customerName = "",
  emailBody = "Your review has been received. We really appreciate you taking the time!",
  product = {},
  review = {},
  buttonUrl = "#",
  buttonText = "View your review",
  emailFooterText = "",
  unsubscribeUrl = "#",
  isShowFooterBadge = true,
} = locals;
%>

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<title><%= subject %></title>
</head>
<body style="margin:0;padding:0;background-color:#f3f4f6;font-family:Arial,Helvetica,sans-serif;">
  <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="width:100%;border-collapse:collapse;background-color:#f3f4f6;margin:0;padding:24px 0;">
    <tr>
      <td align="center" style="padding:12px;">
        <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="355" style="width:355px;max-width:355px;border-collapse:separate;background-color:#f7f7f7;border:1px solid #e1e1e1;border-radius:16px;">
          <tr>
            <td style="padding:22px 20px 18px 20px;">
              <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="border-collapse:collapse;">
                <tr>
                  <td valign="middle" style="width:42px;padding-right:10px;">
                    <% if (logo) { %>
                      <img
                        src="<%= logo %>"
                        alt="Qorix Review"
                        style="display:block;max-width:160px;width:auto;height:42px;object-fit:contain;"
                      />
                    <% } else { %>
                      <div style="width:42px;height:42px;border-radius:50%;border:4px solid #14944c;color:#14944c;font-size:29px;line-height:34px;font-weight:400;text-align:center;box-sizing:border-box;">
                        Q
                      </div>
                    <% } %>
                  </td>
                </tr>
              </table>

              <% if (tagline) { %>
                <div style="font-size:15px;line-height:22px;color:#111111;padding-top:18px;"><%= tagline %></div>
              <% } %>

              <div style="border-top:1px solid #dddddd;margin-top:18px;padding-top:22px;font-size:15px;line-height:24px;color:#111111;">
                <%= emailBody %>
              </div>

              <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="border-collapse:separate;border:1px solid #dddddd;border-radius:8px;background-color:#fbfbfb;margin-top:22px;">
                <tr>
                  <td style="padding:16px 14px;">
                    <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="border-collapse:collapse;">
                      <tr>
                        <td valign="middle" style="width:62px;">
                          <div style="width:54px;height:54px;border-radius:50%;border:1px solid #d7d7d7;text-align:center;line-height:54px;color:#b5b5b5;font-size:24px;">
                            &#9787;
                          </div>
                        </td>
                        <td valign="middle">
                          <% if (review.rating) { %>
                            <div style="font-size:14px;line-height:14px;color:#ffb400;letter-spacing:1px;padding-bottom:6px;">
                              <% for (let i = 0; i < review.rating; i++) { %>&#9733;<% } %>
                            </div>
                          <% } %>
                          <div style="font-size:15px;line-height:20px;font-weight:700;color:#1f1f1f;"><%= product.title || "Hydrating eye cream" %></div>
                          <% if (review.date) { %>
                            <div style="font-size:13px;line-height:18px;color:#8a8a8a;padding-top:2px;"><%= review.date %></div>
                          <% } %>
                        </td>
                      </tr>
                    </table>
                  </td>
                </tr>
              </table>

              <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="border-collapse:collapse;margin-top:28px;">
                <tr>
                  <td align="center" bgcolor="#14944c" style="border-radius:6px;">
                    <a href="<%= buttonUrl %>" style="display:block;padding:16px 18px;font-size:16px;line-height:20px;font-weight:700;color:#ffffff;text-decoration:none;">
                      <%= buttonText %> &nbsp;&#8594;
                    </a>
                  </td>
                </tr>
              </table>

              <div style="text-align:center;padding-top:24px;">
                <% if (emailFooterText) { %>
                  <div style="font-size:12px;line-height:18px;color:#555555;">
                    <%= emailFooterText %><% if (unsubscribeUrl) { %> <span style="color:#bdbdbd;">&middot;</span> <a href="<%= unsubscribeUrl %>" style="color:#555555;text-decoration:underline;">Unsubscribe</a><% } %>
                  </div>
                <% } %>

                <% if (isShowFooterBadge) { %>
                  <div style="font-size:12px;line-height:18px;color:#8f8f8f;padding-top:6px;">
                    Powered by <span style="color:#14944c;font-weight:700;">Qorix</span>
                  </div>
                <% } %>
              </div>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
