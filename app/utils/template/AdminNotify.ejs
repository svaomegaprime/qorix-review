<%
const {
  subject = "New Review Received",
  storeName = "Your Store",
  logo = "",
  tagline = "",
  reviewerName = "Anonymous",
  reviewerEmail = "",
  rating = 0,
  reviewBody = "",
  status = "PENDING",
  productTitle = "",
  productUrl = "#",
  manageUrl = "#",
  submittedDate = "",
  adminEmailBody = "",
} = locals;
%>

<!DOCTYPE html>
<html lang="en" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:o="urn:schemas-microsoft-com:office:office">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="x-apple-disable-message-reformatting">
  <title><%= subject %></title>
</head>
<body style="margin: 0; padding: 0; background-color: #F1F5F9; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; color: #0F172A; -webkit-font-smoothing: antialiased; line-height: 1.5;">

  <!-- Outer Centering Table -->
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin: 0; padding: 0; width: 100%; background-color: #F1F5F9; border-collapse: collapse;">
    <tr>
      <td align="center" style="padding: 48px 16px 64px 16px; background-color: #F1F5F9;">

        <!-- Main Email Card -->
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width: 580px; width: 100%; background-color: #FFFFFF; border: 1px solid #E2E8F0; border-radius: 16px; border-collapse: separate; overflow: hidden; box-shadow: 0 20px 25px -5px rgba(15, 23, 42, 0.06), 0 8px 10px -6px rgba(15, 23, 42, 0.03);">

          <!-- Top Accent Line -->
          <tr>
            <td style="height: 5px; background-color: #0F172A; background: linear-gradient(90deg, #0F172A 0%, #2563EB 50%, #4F46E5 100%); line-height: 5px; font-size: 0;">&nbsp;</td>
          </tr>

          <!-- Brand Header -->
          <tr>
            <td align="center" style="padding: 40px 36px 28px 36px; background-color: #FFFFFF; border-bottom: 1px solid #F1F5F9; text-align: center;">
              <% if (logo) { %>
                <img src="<%= logo %>" alt="<%= storeName %>" style="max-height: 48px; max-width: 220px; width: auto; height: auto; object-fit: contain; display: inline-block; border: 0; vertical-align: middle;">
              <% } else { %>
                <h1 style="margin: 0; font-size: 24px; font-weight: 800; color: #0F172A; letter-spacing: -0.6px; line-height: 1.2; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;"><%= storeName %></h1>
              <% } %>
              <% if (tagline) { %>
                <p style="margin: 8px 0 0 0; font-size: 13px; color: #64748B; font-weight: 400; line-height: 1.4;"><%= tagline %></p>
              <% } %>
            </td>
          </tr>

          <!-- Main Content Area -->
          <tr>
            <td style="padding: 36px 36px 32px 36px; background-color: #FFFFFF;">

              <!-- Moderation Status Badge & Header -->
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-bottom: 24px; border-collapse: collapse;">
                <tr>
                  <td align="left" style="vertical-align: middle;">
                    <span style="font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; color: #64748B; display: block; margin-bottom: 4px;">Admin Alert</span>
                    <h2 style="margin: 0; font-size: 20px; font-weight: 700; color: #0F172A; letter-spacing: -0.3px; line-height: 1.3;">New Customer Review</h2>
                  </td>
                  <td align="right" style="vertical-align: middle;">
                    <% if (status === 'PUBLISHED') { %>
                      <span style="display: inline-block; padding: 6px 14px; background-color: #ECFDF5; border: 1px solid #A7F3D0; border-radius: 9999px; color: #047857; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; white-space: nowrap;">
                        <span style="color: #10B981; font-weight: 900; margin-right: 4px;">●</span> Auto-Published
                      </span>
                    <% } else { %>
                      <span style="display: inline-block; padding: 6px 14px; background-color: #FFFBEB; border: 1px solid #FDE68A; border-radius: 9999px; color: #B45309; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; white-space: nowrap;">
                        <span style="color: #F59E0B; font-weight: 900; margin-right: 4px;">●</span> Pending Moderation
                      </span>
                    <% } %>
                  </td>
                </tr>
              </table>

              <% if (adminEmailBody) { %>
                <!-- Admin Custom Notice Box -->
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-bottom: 28px; background-color: #EFF6FF; border: 1px solid #BFDBFE; border-left: 4px solid #2563EB; border-radius: 8px; border-collapse: separate;">
                  <tr>
                    <td style="padding: 16px 20px; font-size: 14px; color: #1E40AF; line-height: 1.6; font-weight: 500;">
                      <%= adminEmailBody %>
                    </td>
                  </tr>
                </table>
              <% } %>

              <!-- Review Card Container -->
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color: #F8FAFC; border: 1px solid #E2E8F0; border-radius: 14px; margin-bottom: 24px; border-collapse: separate; overflow: hidden;">

                <!-- Product & Rating Header -->
                <tr>
                  <td style="padding: 24px 24px 20px 24px; background-color: #F8FAFC;">

                    <% if (productTitle) { %>
                      <div style="font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.8px; color: #64748B; margin-bottom: 6px;">Product</div>
                      <h3 style="margin: 0 0 14px 0; font-size: 18px; font-weight: 700; line-height: 1.35; color: #0F172A;">
                        <a href="<%= productUrl %>" target="_blank" style="color: #2563EB; text-decoration: none;"><%= productTitle %></a>
                      </h3>
                    <% } %>

                    <!-- Rating Stars Pill Box -->
                    <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="border-collapse: collapse;">
                      <tr>
                        <td style="background-color: #FFFFFF; border: 1px solid #E2E8F0; padding: 6px 14px; border-radius: 8px; vertical-align: middle;">
                          <span style="font-size: 16px; color: #F59E0B; letter-spacing: 3px; vertical-align: middle; line-height: 1;">
                            <% for (let i = 1; i <= 5; i++) { %>
                              <%= i <= rating ? '★' : '☆' %>
                            <% } %>
                          </span>
                          <span style="font-size: 13px; font-weight: 700; color: #0F172A; margin-left: 8px; vertical-align: middle; line-height: 1;">
                            <%= rating %>.0 / 5.0
                          </span>
                        </td>
                      </tr>
                    </table>

                  </td>
                </tr>

                <!-- Review Content Box -->
                <tr>
                  <td style="padding: 0 24px 24px 24px; background-color: #F8FAFC;">
                    <% if (reviewBody) { %>
                      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color: #FFFFFF; border: 1px solid #E2E8F0; border-left: 4px solid #4F46E5; border-radius: 10px; border-collapse: separate;">
                        <tr>
                          <td style="padding: 18px 20px;">
                            <p style="margin: 0; font-size: 15px; color: #334155; line-height: 1.65; font-style: italic; font-family: Georgia, -apple-system, serif;">
                              &ldquo;<%= reviewBody %>&rdquo;
                            </p>
                          </td>
                        </tr>
                      </table>
                    <% } else { %>
                      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color: #FFFFFF; border: 1px dashed #CBD5E1; border-radius: 10px; border-collapse: separate;">
                        <tr>
                          <td style="padding: 16px 20px; text-align: center;">
                            <p style="margin: 0; font-size: 13px; color: #94A3B8; font-style: italic;">
                              No text feedback was provided by the customer.
                            </p>
                          </td>
                        </tr>
                      </table>
                    <% } %>
                  </td>
                </tr>

              </table>

              <!-- Customer Meta Card -->
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color: #FFFFFF; border: 1px solid #E2E8F0; border-radius: 14px; margin-bottom: 32px; border-collapse: separate; overflow: hidden;">
                <tr>
                  <td style="padding: 20px 24px;">
                    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border-collapse: collapse;">

                      <!-- Customer Row -->
                      <tr>
                        <td style="padding: 8px 0; font-size: 13px; color: #64748B; width: 110px; font-weight: 500; vertical-align: middle;">Reviewer</td>
                        <td style="padding: 8px 0; font-size: 14px; color: #0F172A; font-weight: 700; vertical-align: middle;"><%= reviewerName %></td>
                      </tr>

                      <!-- Email Row -->
                      <% if (reviewerEmail) { %>
                        <tr>
                          <td style="padding: 10px 0 8px 0; font-size: 13px; color: #64748B; width: 110px; font-weight: 500; border-top: 1px solid #F1F5F9; vertical-align: middle;">Email</td>
                          <td style="padding: 10px 0 8px 0; font-size: 14px; font-weight: 600; border-top: 1px solid #F1F5F9; vertical-align: middle;">
                            <a href="mailto:<%= reviewerEmail %>" style="color: #2563EB; text-decoration: none;"><%= reviewerEmail %></a>
                          </td>
                        </tr>
                      <% } %>

                      <!-- Date Row -->
                      <% if (submittedDate) { %>
                        <tr>
                          <td style="padding: 10px 0 8px 0; font-size: 13px; color: #64748B; width: 110px; font-weight: 500; border-top: 1px solid #F1F5F9; vertical-align: middle;">Submitted</td>
                          <td style="padding: 10px 0 8px 0; font-size: 14px; color: #334155; font-weight: 600; border-top: 1px solid #F1F5F9; vertical-align: middle;"><%= submittedDate %></td>
                        </tr>
                      <% } %>

                    </table>
                  </td>
                </tr>
              </table>

              <!-- Call-to-Action Button -->
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border-collapse: collapse;">
                <tr>
                  <td align="center">
                    <a href="<%= manageUrl %>" target="_blank" style="width: 100%; padding: 16px 0px; display: inline-block; background-color: #0F172A; color: #FFFFFF; text-decoration: none; font-size: 15px; font-weight: 700; border-radius: 12px; text-align: center; box-shadow: 0 4px 14px rgba(15, 23, 42, 0.2); letter-spacing: -0.2px;">
                      Manage in Dashboard &rarr;
                    </a>
                  </td>
                </tr>
              </table>

            </td>
          </tr>

          <!-- Footer Section -->
          <tr>
            <td style="padding: 28px 36px; background-color: #F8FAFC; border-top: 1px solid #F1F5F9; text-align: center; font-size: 12px; color: #94A3B8; line-height: 1.7;">
              This automated notification was generated by your <strong style="color: #475569; font-weight: 600;">Qorix Review</strong> app settings.<br>
              © <%= new Date().getFullYear() %> <strong style="color: #334155; font-weight: 600;"><%= storeName %></strong> · Powered by <strong style="color: #0F172A; font-weight: 700;">Qorix</strong>
            </td>
          </tr>

        </table>

      </td>
    </tr>
  </table>

</body>
</html>
>
</html>
