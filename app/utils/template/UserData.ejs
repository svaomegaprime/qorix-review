      <div style="display:flex; flex-direction:column; gap:24px;">
      <!-- Greeting -->
      <div style="font-size:13px; line-height: 16px; color:#303030;">
        <p style="font-weight:550; margin:0 0 8px;">Hi Osman,</p>
        <p style="font-weight:400;">
          Thank you for your recent order from Qorix Review! We'd love to hear what you think. It only takes 30 seconds.
        </p>
      </div>

      <!-- Product box -->
      <div style="display:flex; flex-direction:column; gap:16px;">

        <div
          style="display:flex; align-items:center; gap:14px; border:1px solid #ececec; border-radius:12px; padding:12px; box-sizing:border-box;">
          <img src="https://images.unsplash.com/photo-1571781926291-c477ebfd024b?w=120&h=120&fit=crop"
            alt="Hydrating eye cream"
            style="width:72px; height:72px; border-radius:8px; object-fit:cover; flex-shrink:0; background:#D9D9D9;">
          <div style="display:flex; flex-direction:column; gap:9px; font-size:13px; line-height: 16px;">
            <a href="<%= productUrl %>" style="font-weight:550; color:#303030; "><%= productTitle %></a>
            <span style="font-weight:400; color:#616161;">Ordered, march 14, 2026</span>
          </div>
        </div>

      </div>

      <!-- CTA button -->
      <a href="<%= manageUrl %>" style="display:inline-flex; align-items:center; justify-content:center; gap:8px; width:100%; background:#108848; color:#ffffff; text-decoration:none; font-size:16px; line-height: 20px; font-weight:500; padding:12px; border-radius:12px; box-sizing:border-box;">Leave
        a review &rarr; </a>
    </div>

      <!-- Footer -->
      <div style="text-align:center; border-top:1px solid #EBEBEB; margin-top:40px; padding-top:16px;">
        <div style="font-size:13px; font-weight:500; color:#616161; line-height: 1.2;">@2026 <%= storeName %> &nbsp;·&nbsp; 
          <a href="#" style="color:#616161; text-decoration:underline;">Unsubscribe</a>
        </div>
        <div style="margin-top:16px; font-weight:500; font-size:13px;  line-height: 1.2; color:#303030;">Powered by
          <span style="color:#108848;">Qorix</span></div>
